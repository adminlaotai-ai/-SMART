          #guide-content .g-layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:14px;align-items:start}
          #guide-content .g-toc{position:sticky;top:12px;background:#fff;border-radius:14px;padding:12px;box-shadow:var(--shadow-card);max-height:calc(100vh - 40px);overflow-y:auto}
          #guide-content .g-toc .grp{font-size:11.5px;font-weight:700;color:var(--g-orange);letter-spacing:.02em;margin:10px 6px 4px}
          #guide-content .g-toc a{display:block;padding:6px 8px;border-radius:8px;color:var(--g-ink);text-decoration:none;font-size:13px}
          #guide-content .g-toc a:hover{background:var(--g-soft)}
          #guide-content .g-toc a.off{color:#a0aec0}
          #guide-content .g-tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#fff;border-radius:14px;padding:12px;box-shadow:var(--shadow-card);margin-bottom:14px}
          #guide-content .g-tools .form-control{flex:1 1 220px}
          #guide-content .g-group-title{display:flex;align-items:center;gap:8px;margin:18px 4px 10px;color:var(--g-navy);font-weight:700;font-size:16px}
          #guide-content .g-group-title:first-child{margin-top:0}
          #guide-content .g-item{background:#fff;border-radius:14px;padding:16px 18px;box-shadow:var(--shadow-card);margin-bottom:12px;scroll-margin-top:70px}

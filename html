  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();

  return { open: openDrawer, close: closeDrawer, toggle: toggleDrawer, afterTab: afterTab, refresh: refreshAll };
})();
</script>

  // 🚚 ບັນທຶກການນຳໃຊ້ລົດ (VEHICLE USAGE) — ໃຊ້ລົດ + ແທກນ້ຳມັນ ແຕ່ບໍ່ໄດ້ຕື່ມ
  // ==========================================
  let vuLastLevel = null;
  let vuTableRows = [];
  let vuInitialized = false;

  function vuEsc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function vuNum(v) { return parseFloat(v) || 0; }

  function vuSetNow() {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    document.getElementById('vuTimestamp').value = now.toISOString().slice(0, 16);
  }

  // ສຳເນົາ option ຈາກ dropdown ຂອງຟອມນ້ຳມັນອອກ (ລວມທັງອັນທີ່ກົດ "+" ເພີ່ມໃໝ່) ມາໃຊ້ຮ່ວມກັນ
  function vuCopyOptions(srcId, dstId, placeholder) {
    const src = document.getElementById(srcId), dst = document.getElementById(dstId);
    if (!src || !dst) return;
    const keep = dst.value;
    dst.innerHTML = `<option value="">${placeholder}</option>`;
    Array.from(src.options).forEach(o => { if (o.value) dst.add(new Option(o.text, o.value)); });
    if (keep) dst.value = keep;
  }

  function vuInitPage() {
    vuCopyOptions('carnumber', 'vuCarnumber', '-- ເລືອກທະບຽນລົດ --');

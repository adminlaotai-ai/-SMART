  /* ===================== ຕົວຊ່ວຍ ===================== */
  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function access(it) {
    if (it.admin) return currentUser && currentUser.role === 'Admin' ? 'ok' : 'no';
    if (!it.tab) return 'all';
    var b = $(it.tab + '-tab'); if (!b) return 'no';
    var li = b.closest('li'); return (li && li.style.display === 'none') ? 'no' : 'ok';
  }
  function hl(text, q) {
    var t = esc(text); if (!q) return t;
    var i = t.toLowerCase().indexOf(q.toLowerCase()); if (i < 0) return t;
    return t.slice(0, i) + '<mark>' + t.slice(i, i + q.length) + '</mark>' + t.slice(i + q.length);
  }

  /* ===================== ຄູ່ມື ===================== */
  function renderManual() {

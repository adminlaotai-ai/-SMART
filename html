          Swal.fire('ເກີດຂໍ້ຜິດພາດ', (res && res.error ? res.error : 'ບັນທຶກບໍ່ສຳເລັດ'), 'error');
          return;
        }
        currentUser.name = name;
        document.getElementById('display-user-name').innerText = name;
        document.getElementById('recorderName').value = name;
        document.getElementById('stockRecordedBy').value = name;
        const savedSession = localStorage.getItem('smart_fuel_user_session');
        if (savedSession) {

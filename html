  /* ---------- ຕາຕະລາງລົດເຊົ່າ/ສ້ອມແປງ → ບັດ (ໃສ່ປ້າຍຖັນໃຫ້ແຕ່ລະຊ່ອງ) ---------- */
  function labelTable(t) {
    var head = t.tHead && t.tHead.rows.length ? t.tHead.rows[t.tHead.rows.length - 1] : null;
    if (!head) return;
    var labels = [];
    Array.prototype.forEach.call(head.cells, function (th) {
      var txt = th.textContent.replace(/\s+/g, ' ').trim();
      for (var i = 0; i < (th.colSpan || 1); i++) labels.push(txt);
    });
    var sections = Array.prototype.slice.call(t.tBodies); if (t.tFoot) sections.push(t.tFoot);
    sections.forEach(function (sec) {
      Array.prototype.forEach.call(sec.rows, function (tr) {
        var c = 0;
        Array.prototype.forEach.call(tr.cells, function (td) {

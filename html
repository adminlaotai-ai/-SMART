      });
    });
    t.classList.add('resp-cards');
  }

  /* ---------- ຄຳແນະນຳ "ເລື່ອນຊ້າຍ-ຂວາ" ສຳລັບຕາຕະລາງກວ້າງ ---------- */
  function scrollHint(box) {
    var hint = box.previousElementSibling;
    if (!hint || !hint.classList || !hint.classList.contains('scroll-hint')) {
      hint = document.createElement('div'); hint.className = 'scroll-hint'; hint.hidden = true;
      hint.innerHTML = '<i class="bi bi-arrow-left-right"></i> ເລື່ອນຊ້າຍ-ຂວາ ເພື່ອເບິ່ງຂໍ້ມູນທັງໝົດ';
      box.parentNode.insertBefore(hint, box);
    }
    hint.hidden = !(MOBILE.matches && box.offsetParent !== null && box.scrollWidth > box.clientWidth + 4);
  }

  function refreshAll() {
    document.querySelectorAll('.rt-tbl table, .mt-tbl table').forEach(labelTable);
    document.querySelectorAll('.main-content .table-responsive, .main-content .rt-tbl, .main-content .mt-tbl, .main-content .fl-tbl').forEach(scrollHint);
  }
  var timer = null;
  function schedule() { clearTimeout(timer); timer = setTimeout(refreshAll, 120); }

  function init() {
    var mc = document.querySelector('.main-content');
    if (mc && window.MutationObserver) new MutationObserver(function (list) {
      for (var i = 0; i < list.length; i++) if (list[i].type === 'childList' && !(list[i].target.classList && list[i].target.classList.contains('scroll-hint'))) { schedule(); return; }

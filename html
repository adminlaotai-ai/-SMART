          (it.tab && acc === 'ok' ? '<button class="btn btn-sm btn-outline-primary py-0 g-go" onclick="switchTab(\'' + it.tab + '\')">ໄປທີ່ໜ້ານີ້ →</button>' : '') + '</h6>' +
          '<p class="purpose">' + hl(it.purpose, q) + '</p><ol class="g-steps">' + (it.steps || []).map(function (s) { return '<li>' + hl(s, q) + '</li>'; }).join('') + '</ol>' +

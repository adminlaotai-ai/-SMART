  const LEVELED_PERMISSION_KEYS = ['tableOut', 'tableIn', 'rentalContracts', 'rentalLogs', 'rentalBilling', 'rentalPayments', 'rentalReport', 'mtOverview', 'mtForm', 'mtHistory', 'mtVehicles', 'mtReport'];
  const MODULE_PERMISSION_GROUPS = { rental: ['rentalContracts', 'rentalLogs', 'rentalBilling', 'rentalPayments', 'rentalReport'], mt: ['mtOverview', 'mtForm', 'mtHistory', 'mtVehicles', 'mtReport'] };

  // ຕັ້ງສິດທັງກຸ່ມ (ໃນຟອມຈັດການຜູ້ໃຊ້) — ຖ້າໜ້າໃດບໍ່ມີລະດັບນັ້ນ ຈະໃຊ້ລະດັບທີ່ໃກ້ທີ່ສຸດ
  function setModulePerms(group, level) {

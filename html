<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
  let currentUser = null;
  let globalData = { stations: [], rawData: [], userList: [] };
  let globalStockInData = [];
  let fuelChartInstance = null;
  let distanceChartInstance = null;
  let siteFuelDoughnutChartInstance = null;
  let stockSummaryChartInstance = null;
  let bsUserModal = null;

  // ⏰ ໝົດອາຍຸ session ອັດຕະໂນມັດຫຼັງຈາກ 12 ຊົ່ວໂມງ (ກັນລືມກົດອອກຈາກລະບົບ)
  const SESSION_MAX_AGE_MS = 12 * 60 * 60 * 1000; // 12 ຊົ່ວໂມງ

  function isSessionExpired_() {
    const loginTime = Number(localStorage.getItem('smart_fuel_login_time') || 0);
    if (!loginTime) return false; // ບໍ່ມີເວລາບັນທຶກໄວ້ (session ເກົ່າກ່ອນອັບເດດນີ້) - ບໍ່ບັງຄັບອອກ, ຈະເລີ່ມນັບໃໝ່ຄັ້ງຕໍ່ໄປ
    return (Date.now() - loginTime) > SESSION_MAX_AGE_MS;
  }

  function startAutoLogoutWatcher_() {
    setInterval(() => {
      if (currentUser && isSessionExpired_()) {
        localStorage.removeItem('smart_fuel_user_session');
        localStorage.removeItem('smart_fuel_login_time');
        currentUser = null;
        document.getElementById('main-app').style.display = 'none';
        document.getElementById('login-page').style.display = 'flex';
        document.getElementById('loginForm').reset();
        Swal.fire('ໝົດເວລາການເຂົ້າໃຊ້ລະບົບ', 'ທ່ານໄດ້ຖືກອອກຈາກລະບົບອັດຕະໂນມັດ ເນື່ອງຈາກເຂົ້າໃຊ້ຄົບ 12 ຊົ່ວໂມງ ກະລຸນາເຂົ້າສູ່ລະບົບໃໝ່', 'info');
      }
    }, 60 * 1000); // ກວດທຸກໆ 1 ນາທີ
  }

  document.addEventListener('DOMContentLoaded', () => {
    autoSetCurrentTimestamp();
    autoSetStockDate();
    setupCalculations();
    checkExistingSession();
    startAutoLogoutWatcher_();
  });

  function onFailure(e) {
    Swal.fire('ເກີດຂໍ້ຜິດພາດ', e.message || e.toString(), 'error');
  }

  function checkExistingSession() {
    try {
      if (isSessionExpired_()) {
        localStorage.removeItem('smart_fuel_user_session');
        localStorage.removeItem('smart_fuel_login_time');
        return;
      }
      const savedSession = localStorage.getItem('smart_fuel_user_session');
      if (savedSession) {
        const res = JSON.parse(savedSession);
        onLoginSuccess(res, false);
        // 🔄 ຄືນຄ່າ session ຈາກ cache ກ່ອນ (ໄວ) ແລ້ວອັບເດດສິດລ່າສຸດຈາກເຊີບເວີແບບ silent ຢູ່ພື້ນຫຼັງ
        // ເພື່ອບໍ່ໃຫ້ຕິດບັນຫາ "Admin ແກ້ໄຂສິດແລ້ວ ແຕ່ຜູ້ໃຊ້ຍັງເຫັນເມນູເກົ່າ" ຈົນກວ່າຈະ logout ເອງ
        if (res && res.user && res.user.username) {
          google.script.run
            .withSuccessHandler((fresh) => {
              if (fresh && fresh.success) {
                onLoginSuccess({ success: true, user: fresh.user, groupId: res.groupId }, false);
              }
            })
            .withFailureHandler(() => {})
            .refreshMyPermissions(res.user.username);
        }
      }
    } catch (e) {
      console.error("Error reading saved session:", e);
      localStorage.removeItem('smart_fuel_user_session');
      localStorage.removeItem('smart_fuel_login_time');
    }
  }

  function autoSetCurrentTimestamp() {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    document.getElementById('recordTimestamp').value = now.toISOString().slice(0, 16);
  }

  function autoSetStockDate() {
    const today = new Date().toISOString().slice(0, 10);
    const stockDateElem = document.getElementById('stockDate');
    if (stockDateElem) stockDateElem.value = today;
  }

  function setupCalculations() {
    const calcInputs = document.querySelectorAll('.calc-trigger');
    calcInputs.forEach(input => {
      input.addEventListener('input', calculateFields);
    });
  }

  function calculateFields() {
    const fuelBefore = parseFloat(document.getElementById('fuelBeforeLitre').value) || 0;
    const fuelAfter = parseFloat(document.getElementById('fuelAfterLitre').value) || 0;
    const totalLitre = fuelBefore + fuelAfter;

    const kmBefore = parseFloat(document.getElementById('kmBefore').value) || 0;
    const kmAfter = parseFloat(document.getElementById('kmAfter').value) || 0;
    const totalKm = Math.max(0, kmAfter - kmBefore);

    const hsBefore = document.getElementById('hsBefore').value;
    const hsAfter = document.getElementById('hsAfter').value;
    let totalHs = 0;

    if (hsBefore && hsAfter) {
      const sParts = hsBefore.split(':');
      const eParts = hsAfter.split(':');
      if (sParts.length === 2 && eParts.length === 2) {
        const startMin = parseInt(sParts[0], 10) * 60 + parseInt(sParts[1], 10);
        const endMin = parseInt(eParts[0], 10) * 60 + parseInt(eParts[1], 10);
        let diffMin = endMin - startMin;
        if (diffMin < 0) diffMin += 24 * 60;
        totalHs = Math.max(0, diffMin / 60);
      }
    }

    const kml = totalLitre > 0 ? (totalKm / totalLitre) : 0;

    document.getElementById('previewTotalLitre').innerText = totalLitre.toFixed(2) + " ລິດ";
    document.getElementById('previewTotalKm').innerText = totalKm.toFixed(0) + " KM";
    document.getElementById('previewTotalHs').innerText = totalHs.toFixed(1) + " Hs";
    document.getElementById('previewKml').innerText = kml.toFixed(2) + " KM/L";
  }

  function handleLogin(e) {
    e.preventDefault();
    const userVal = document.getElementById('username').value;
    const passVal = document.getElementById('password').value;

    Swal.fire({ title: 'ກຳລັງເຂົ້າສູ່ລະບົບ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

    navigator.geolocation.getCurrentPosition(
      (pos) => performLogin(userVal, passVal, { lat: pos.coords.latitude, lng: pos.coords.longitude }),
      (err) => performLogin(userVal, passVal, null),
      { timeout: 5000 }
    );
  }

  function performLogin(username, password, locationData) {
    const deviceInfo = navigator.userAgent;
    google.script.run
      .withSuccessHandler(onLoginSuccess)
      .withFailureHandler(onFailure)
      .checkLogin(username, password, deviceInfo, locationData);
  }

  function onLoginSuccess(res, isNewLogin = true) {
    if (!res.success) {
      Swal.fire('ເຂົ້າລະບົບບໍ່ສຳເລັດ', res.error, 'error');
      localStorage.removeItem('smart_fuel_user_session');
      return;
    }

    if (isNewLogin) {
      localStorage.setItem('smart_fuel_user_session', JSON.stringify(res));
      localStorage.setItem('smart_fuel_login_time', Date.now().toString());
    }

    currentUser = res.user;
    document.getElementById('display-user-name').innerText = currentUser.name;
    document.getElementById('display-user-role').innerText = currentUser.role;
    document.getElementById('display-group-id').innerText = res.groupId ? 'ເຊື່ອມຕໍ່ແລ້ວ' : 'ບໍ່ໄດ້ເຊື່ອມຕໍ່';
    document.getElementById('recorderName').value = currentUser.name;
    document.getElementById('stockRecordedBy').value = currentUser.name;
    loadProfilePhoto();

    document.getElementById('login-page').style.display = 'none';
    document.getElementById('main-app').style.display = 'block';

    if (currentUser.role === 'Admin') {
      document.getElementById('admin-tab-li').style.display = 'block';
      document.getElementById('table-tab-li').style.display = 'block';
      document.getElementById('table-in-tab-li').style.display = 'block';
      document.getElementById('stock-summary-tab-li').style.display = 'block';
      document.getElementById('daily-report-tab-li').style.display = 'block';
      document.getElementById('monthly-report-tab-li').style.display = 'block';
      document.getElementById('yearly-report-tab-li').style.display = 'block';
      document.getElementById('history-tab-li').style.display = 'block';
      document.getElementById('user-manage-tab-li').style.display = 'block';
      document.getElementById('vehicle-station-tab-li').style.display = 'block';
      document.getElementById('vehicle-usage-tab-li').style.display = 'block';
      document.getElementById('vehicle-usage-table-tab-li').style.display = 'block';
      applyModuleMenuPermissions_(null);
      const testBtn = document.getElementById('testLowStockBtn');
      if (testBtn) testBtn.style.display = 'inline-block';
    } else {
      const p = currentUser.permissions || {};
      const canTableOut = p.tableOut && p.tableOut !== 'none';
      const canTableIn = p.tableIn && p.tableIn !== 'none';
      document.getElementById('admin-tab-li').style.display = p.dashboard ? 'block' : 'none';
      document.getElementById('table-tab-li').style.display = canTableOut ? 'block' : 'none';
      document.getElementById('table-in-tab-li').style.display = canTableIn ? 'block' : 'none';
      document.getElementById('stock-summary-tab-li').style.display = (canTableIn && p.stockSummary) ? 'block' : 'none';
      document.getElementById('daily-report-tab-li').style.display = (canTableIn && p.dailyReport) ? 'block' : 'none';
      document.getElementById('monthly-report-tab-li').style.display = (canTableIn && p.monthlyReport) ? 'block' : 'none';
      document.getElementById('yearly-report-tab-li').style.display = (canTableIn && p.yearlyReport) ? 'block' : 'none';
      document.getElementById('history-tab-li').style.display = canTableOut ? 'block' : 'none';
      document.getElementById('user-manage-tab-li').style.display = p.manageUsers ? 'block' : 'none';
      document.getElementById('form-tab').parentElement.style.display = p.recordOut ? '' : 'none';
      document.getElementById('form-in-tab').parentElement.style.display = p.recordIn ? '' : 'none';
      document.getElementById('vehicle-usage-tab-li').style.display = (p.vehicleUsage || p.recordOut) ? '' : 'none';
      document.getElementById('vehicle-usage-table-tab-li').style.display = (p.vehicleUsage || p.recordOut) ? '' : 'none';
      applyModuleMenuPermissions_(p);

      const activeTab = document.querySelector('#mainTabs .nav-link.active');
      if (activeTab) {
        const li = activeTab.parentElement;
        if (li.style.display === 'none') {
          const firstVisible = Array.from(document.querySelectorAll('#mainTabs .nav-item'))
            .find(item => item.style.display !== 'none');
          if (firstVisible) firstVisible.querySelector('.nav-link').click();
        }
      }
    }

    if (isNewLogin) Swal.close();
    loadSystemInitialData();
  }

  function handleLogout() {
    Swal.fire({
      title: 'ອອກຈາກລະບົບ?',
      text: 'ທ່ານຕ້ອງການອອກຈາກລະບົບແທ້ບໍ?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#ff8c00',
      cancelButtonColor: '#6c757d',
      confirmButtonText: '✅ ອອກຈາກລະບົບ',
      cancelButtonText: 'ຍົກເລີກ'
    }).then((res) => {
      if (res.isConfirmed) {
        doLogout();
      }
    });
  }

  function doLogout() {
    const usernameToLogout = currentUser ? currentUser.username : "";
    const finishLogout = () => {
      localStorage.removeItem('smart_fuel_user_session');
      localStorage.removeItem('smart_fuel_login_time');
      currentUser = null;
      document.getElementById('main-app').style.display = 'none';
      document.getElementById('login-page').style.display = 'flex';
      document.getElementById('loginForm').reset();
    };
    if (usernameToLogout) {
      google.script.run.withFailureHandler(() => {}).recordLogout(usernameToLogout);
    }
    finishLogout();
  }

  function loadSystemInitialData() {
    google.script.run
      .withSuccessHandler(onDataLoaded)
      .withFailureHandler(onFailure)
      .getInitialData(currentUser ? currentUser.username : "");
  }

  function onDataLoaded(res) {
    if (res.error) {
      Swal.fire('ເກີດຂໍ້ຜິດພາດ', res.error, 'error');
      return;
    }
    globalData = res;
    populateStationDropdown(res.stations);
    populatePeopleSelects(res.people);
    stationGuardUpdate('carnumber', 'location', 'locationGuard');
    renderTableData(res.rawData);
    renderAccordionHistory(res.rawData, res.stations);
    renderUserTable(res.userList);

    const canDashboard = currentUser && (currentUser.role === 'Admin' || (currentUser.permissions && currentUser.permissions.dashboard));
    if (canDashboard) {
      updateDashboard(res.rawData);
      renderCharts(res.rawData);
      loadDashboardStockRemaining();
    }

    const canTableIn = currentUser && (currentUser.role === 'Admin' || (currentUser.permissions && currentUser.permissions.tableIn && currentUser.permissions.tableIn !== 'none'));
    if (canTableIn) loadStockTable();
  }

  function populateStationDropdown(stations) {
    const selects = [document.getElementById('location'), document.getElementById('stockSite'), document.getElementById('reportStation'), document.getElementById('monthlyReportStation'), document.getElementById('yearlyReportStation'), document.getElementById('vuLocation')];
    selects.forEach(select => {
      if (!select) return;
      select.innerHTML = '<option value="" selected disabled>-- ເລືອກສະຖານທີ່ --</option>';
      if (stations && stations.length > 0) {
        stations.forEach(st => {
          const opt = document.createElement('option');
          opt.value = st;
          opt.innerText = st;
          select.appendChild(opt);
        });
      }
    });
    const vuF = document.getElementById('vuFilterStation');
    if (vuF) {
      vuF.innerHTML = '<option value="">ທັງໝົດ</option>';
      (stations || []).forEach(st => vuF.add(new Option(st, st)));
    }
  }

  function switchTab(tabName) {
    document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.dashboard-container').forEach(div => div.classList.remove('active'));

    const targetTabBtn = document.getElementById(`${tabName}-tab`);
    const targetContent = document.getElementById(`${tabName}-content`);

    if (targetTabBtn) targetTabBtn.classList.add('active');
    if (targetContent) targetContent.classList.add('active');

    // 🚜 ລົດເຊົ່າ ແລະ 🔧 ສ້ອມແປງ: ແຕ່ລະໂມດູນໃຊ້ໜ້າດຽວ ແລະ ສະຫຼັບພາກສ່ວນພາຍໃນ
    if (tabName.indexOf('rental-') === 0) {
      document.getElementById('rental-content').classList.add('active');
      RT.open(tabName.slice(7));
    }
    if (tabName.indexOf('mt-') === 0) {
      document.getElementById('mt-content').classList.add('active');
      MT.open(tabName.slice(3));
    }
    // 📘 ຄູ່ມື ແລະ ສະໄລວິດີໂອ
    if (tabName.indexOf('guide-') === 0) {
      document.getElementById('guide-content').classList.add('active');
      GUIDE.open(tabName.slice(6));
    } else if (window.GUIDE) GUIDE.pause();
    if (window.RESP) RESP.afterTab(tabName);

    if (tabName === 'table-in' || tabName === 'form-in') {
      loadStockTable();
    }
    if (tabName === 'stock-summary') {
      loadStockSummary();
    }
    if (tabName === 'vehicle-usage') {
      vuInitPage();
    }
    if (tabName === 'vehicle-usage-table') {
      vuInitTablePage();
    }
    if (tabName === 'vehicle-station') {
      vsLoad();
    }
    if (tabName === 'daily-report') {
      const dateInput = document.getElementById('reportDate');
      if (dateInput && !dateInput.value) {
        const tz = new Date().getTimezoneOffset() * 60000;
        dateInput.value = new Date(Date.now() - tz).toISOString().slice(0, 10);
      }
    }
    if (tabName === 'monthly-report') {
      const monthInput = document.getElementById('monthlyReportMonth');
      if (monthInput && !monthInput.value) {
        const now = new Date();

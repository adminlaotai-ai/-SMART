  function saveReportSignature(reportType, role) {
    const isRecorder = role === 'recorder';
    const prefix = reportType === 'monthly' ? 'monthly' : 'yearly';
    const idFor = (suffix) => `${prefix}${isRecorder ? 'Recorder' : 'Supervisor'}Sig${suffix}`;
    const fileInput = document.getElementById(idFor('File'));
    const nameInput = document.getElementById(idFor('Name'));
    const previewImg = document.getElementById(idFor('Preview'));
    const btn = document.getElementById(`save${prefix === 'monthly' ? 'Monthly' : 'Yearly'}${isRecorder ? 'Recorder' : 'Supervisor'}SigBtn`);
    const file = fileInput.files[0];

    const station = reportType === 'monthly' ? CURRENT_MONTHLY_STATION : CURRENT_YEARLY_STATION;
    const periodKey = reportType === 'monthly' ? CURRENT_MONTHLY_PERIOD : CURRENT_YEARLY_PERIOD;

    if (!file) { Swal.fire('ແຈ້ງເຕືອນ', 'ກະລຸນາເລືອກຮູບລາຍເຊັນກ່ອນ', 'warning'); return; }
    if (!station || !periodKey) { Swal.fire('ແຈ້ງເຕືອນ', 'ກະລຸນາໂຫຼດລາຍງານກ່ອນ', 'warning'); return; }

    btn.disabled = true; btn.textContent = '⏳ ກຳລັງບັນທຶກ...';
    readFileAsBase64_(file).then(base64 => {
      google.script.run
        .withSuccessHandler((res) => {
          btn.disabled = false; btn.textContent = '💾 ບັນທຶກລາຍເຊັນ';
          if (!res || !res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', (res && res.error ? res.error : 'ບັນທຶກລາຍເຊັນບໍ່ສຳເລັດ'), 'error'); return; }
          previewImg.src = res.signatureUrl; previewImg.style.display = 'block';
          document.getElementById(idFor('NamePrint')).textContent = nameInput.value.trim();
          const metaTxt = `ບັນທຶກລ່າສຸດໂດຍ ${currentUser.username} • ${new Date().toLocaleString()}`;
          document.getElementById(idFor('Meta')).textContent = metaTxt;
          Swal.fire({ title: 'ບັນທຶກລາຍເຊັນສຳເລັດ!', icon: 'success', timer: 1500, showConfirmButton: false });
        })
        .withFailureHandler((err) => { btn.disabled = false; btn.textContent = '💾 ບັນທຶກລາຍເຊັນ'; onFailure(err); })
        .saveReportSignature(currentUser.username, { reportType: reportType, periodKey: periodKey, station: station, role: role, name: nameInput.value.trim(), imageBase64: base64, fileName: file.name });
    }).catch(() => { btn.disabled = false; btn.textContent = '💾 ບັນທຶກລາຍເຊັນ'; Swal.fire('ເກີດຂໍ້ຜິດພາດ', 'ອ່ານໄຟລ໌ບໍ່ໄດ້', 'error'); });
  }


  function vuUseLast() {
    if (!vuLastLevel) return;
    document.getElementById('vuBeforeCm').value = vuLastLevel.cm || '';
    document.getElementById('vuBeforeLitre').value = vuLastLevel.liters;
    if (vuLastLevel.km) document.getElementById('vuKmBefore').value = vuLastLevel.km;
    vuCalc();
  }

  function vuCalc() {
    const beforeL = vuNum(document.getElementById('vuBeforeLitre').value);
    const afterL = vuNum(document.getElementById('vuAfterLitre').value);
    const used = beforeL - afterL;
    const km = Math.max(0, vuNum(document.getElementById('vuKmAfter').value) - vuNum(document.getElementById('vuKmBefore').value));
    let hs = 0;
    const a = document.getElementById('vuHsBefore').value, b = document.getElementById('vuHsAfter').value;
    if (a && b) {
      const t = s => { const [h, m] = s.split(':').map(Number); return h * 60 + m; };
      let diff = t(b) - t(a); if (diff < 0) diff += 1440; hs = diff / 60;
    }
    document.getElementById('vuPrevUsed').innerText = used.toFixed(2) + ' ລິດ';
    document.getElementById('vuPrevKm').innerText = km + ' KM';
    document.getElementById('vuPrevHs').innerText = hs.toFixed(1) + ' Hs';
    document.getElementById('vuPrevKml').innerText = (used > 0 && km > 0 ? km / used : 0).toFixed(2) + ' KM/L';

    const warn = document.getElementById('vuWarn');
    warn.className = 'alert d-none py-2 mb-0 mt-1 small fw-bold';
    let gapTxt = '-';
    if (vuLastLevel && document.getElementById('vuBeforeLitre').value !== '') {
      const gap = vuLastLevel.liters - beforeL;
      gapTxt = (gap > 0 ? '-' : '+') + Math.abs(gap).toFixed(2) + ' ລ';
      if (Math.abs(gap) > 5) {
        warn.className = 'alert alert-danger py-2 mb-0 mt-1 small fw-bold';
        warn.innerText = gap > 0
          ? `⚠️ ນ້ຳມັນຫຼຸດລົງ ${gap.toFixed(2)} ລິດ ນັບຈາກການບັນທຶກຄັ້ງກ່ອນ — ອາດມີການໃຊ້ລົດທີ່ບໍ່ໄດ້ບັນທຶກ ຫຼື ນ້ຳມັນຮົ່ວ/ຫາຍ`
          : `⚠️ ນ້ຳມັນເພີ່ມຂຶ້ນ ${Math.abs(gap).toFixed(2)} ລິດ — ອາດມີການຕື່ມນ້ຳມັນທີ່ບໍ່ໄດ້ບັນທຶກ`;
      }
    }
    if (used < 0) {
      warn.className = 'alert alert-warning py-2 mb-0 mt-1 small fw-bold';
      warn.innerText = '⛽ "ຫຼັງໃຊ້" ຫຼາຍກວ່າ "ກ່ອນໃຊ້" — ຖ້າມີການຕື່ມນ້ຳມັນ ກະລຸນາບັນທຶກທີ່ "ຟອມບັນທຶກນ້ຳມັນອອກ"';
    }
    document.getElementById('vuPrevGap').innerText = gapTxt;
  }

  function vuHandleSubmit(e) {
    e.preventDefault();
    if (!stationGuardCheck('vuCarnumber', 'vuLocation', 'vuLocationGuard', () => vuHandleSubmit(e))) return;
    const g = id => document.getElementById(id).value;
    if (vuNum(g('vuAfterLitre')) > vuNum(g('vuBeforeLitre'))) {
      Swal.fire('ຂໍ້ມູນບໍ່ຖືກຕ້ອງ', 'ນ້ຳມັນ "ຫຼັງໃຊ້" ຫຼາຍກວ່າ "ກ່ອນໃຊ້". ຖ້າມີການຕື່ມນ້ຳມັນ ກະລຸນາບັນທຶກທີ່ "ຟອມບັນທຶກນ້ຳມັນອອກ"', 'warning');
      return;
    }
    const d = {
      recordTimestamp: g('vuTimestamp'), location: g('vuLocation'),
      carnumber: g('vuCarnumber'), cartype: g('vuCartype'), carmodel: g('vuCarmodel'), carstatus: g('vuCarstatus'),
      purpose: g('vuPurpose'),
      fuelBeforeCm: g('vuBeforeCm'), fuelBeforeLitre: g('vuBeforeLitre'),
      fuelAfterCm: g('vuAfterCm'), fuelAfterLitre: g('vuAfterLitre'),
      kmBefore: g('vuKmBefore'), kmAfter: g('vuKmAfter'), hsBefore: g('vuHsBefore'), hsAfter: g('vuHsAfter'),
      driverName: g('vuDriver'), supervisorName: g('vuSupervisor'), note: g('vuNote'),
      notifyEmail: document.getElementById('notifyEmail').checked,
      notifyLine: document.getElementById('notifyLine').checked
    };
    const send = () => {
      Swal.fire({ title: 'ກຳລັງບັນທຶກ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      google.script.run.withSuccessHandler(res => {
        if (res && res.success) {
          const bad = res.checkStatus === 'ກວດສອບ';
          Swal.fire(bad ? 'ບັນທຶກແລ້ວ — ຕ້ອງກວດສອບ' : 'ສຳເລັດ!',
            `ໃຊ້ໄປ ${Number(res.used).toFixed(2)} ລິດ • ${res.totalKm} KM • ${res.hsTotal} Hs` +
            (res.linkedFuel ? `<br>🔻 ຫັກອອກຈາກຕາຕະລາງນ້ຳມັນອອກ (${vuEsc(res.linkedFuel)})<br><b class="fs-5">${res.prevRemaining} → ${res.newRemaining} ລິດ</b>` : '<br><span class="text-muted">ຍັງບໍ່ມີລາຍການນ້ຳມັນອອກຂອງລົດຄັນນີ້ໃຫ້ຫັກ</span>') +
            (bad ? `<br><b class="text-danger">ລະດັບກ່ອນໃຊ້ຕ່າງຈາກຄັ້ງກ່ອນ ${res.gap} ລິດ</b>` : ''),
            bad ? 'warning' : 'success');
          vuResetForm();
          loadSystemInitialData(); // ໂຫຼດຕາຕະລາງນ້ຳມັນອອກໃໝ່ ເພື່ອສະແດງຍອດທີ່ຫັກແລ້ວ
        } else {
          Swal.fire(res && res.wrongStation ? '🚫 ໃສ່ສະໜາມບໍ່ຖືກຕ້ອງ' : 'ເກີດຂໍ້ຜິດພາດ', res ? res.error : 'Unknown error', 'error');
        }
      }).withFailureHandler(onFailure).saveVehicleUsage(currentUser ? currentUser.username : '', d);
    };
    const fileInput = document.getElementById('vuFile');
    if (fileInput.files.length > 0) {
      const file = fileInput.files[0];
      const reader = new FileReader();
      reader.onload = evt => { d.fileData = evt.target.result; d.fileName = file.name; send(); };
      reader.readAsDataURL(file);
    } else {
      send();
    }
  }

  function vuResetForm() {
    const keepLocation = document.getElementById('vuLocation').value;
    document.getElementById('vuForm').reset();
    if (keepLocation) document.getElementById('vuLocation').value = keepLocation;
    document.getElementById('vuCarstatus').value = '';
    document.getElementById('vuRecorder').value = currentUser ? currentUser.name : '';
    document.getElementById('vuLastBox').classList.add('d-none');
    vuLastLevel = null;
    vuSetNow();
    vuCalc();
  }

  function vuCanDelete() {
    if (!currentUser) return false;
    if (currentUser.role === 'Admin') return true;
    const p = currentUser.permissions || {};
    return p.tableOut === 'edit';
  }

  function vuLoadTable() {
    const body = document.getElementById('vuTableBody');
    body.innerHTML = '<tr><td colspan="16" class="text-center text-muted"><span class="spinner-border spinner-border-sm"></span> ກຳລັງໂຫຼດ...</td></tr>';
    const filter = {
      station: document.getElementById('vuFilterStation').value,
      plate: document.getElementById('vuFilterPlate').value,
      startDate: document.getElementById('vuFilterStart').value,
      endDate: document.getElementById('vuFilterEnd').value
    };
    google.script.run.withSuccessHandler(res => {
      if (!res || !res.success) { body.innerHTML = `<tr><td colspan="16" class="text-center text-danger">${vuEsc(res ? res.error : 'Error')}</td></tr>`; return; }
      vuTableRows = res.rows || [];
      vuRenderTable();
    }).withFailureHandler(onFailure).getVehicleUsageList(currentUser ? currentUser.username : '', filter);
  }

  function vuRenderTable() {
    const rows = vuTableRows;
    const sumUsed = rows.reduce((s, r) => s + vuNum(r.used), 0);
    const sumKm = rows.reduce((s, r) => s + vuNum(r.totalKm), 0);
    document.getElementById('vuSumTrips').innerText = rows.length;
    document.getElementById('vuSumUsed').innerText = sumUsed.toFixed(2) + ' ລິດ';
    document.getElementById('vuSumKm').innerText = sumKm.toLocaleString() + ' KM';
    document.getElementById('vuSumCheck').innerText = rows.filter(r => r.checkStatus === 'ກວດສອບ').length;

    const body = document.getElementById('vuTableBody');
    if (!rows.length) { body.innerHTML = '<tr><td colspan="16" class="text-center text-muted">ບໍ່ມີຂໍ້ມູນໃນຊ່ວງນີ້</td></tr>'; return; }
    const canDel = vuCanDelete();
    body.innerHTML = rows.map(r => {
      const bad = r.checkStatus === 'ກວດສອບ';
      const files = (r.fileUrl || '').toString().split(',').map(s => s.trim()).filter(Boolean);
      return `<tr class="${bad ? 'table-warning' : ''}">
        <td>${vuEsc(r.date)}</td><td>${vuEsc(r.station)}</td><td class="fw-bold">${vuEsc(r.carnumber)}</td>
        <td>${vuEsc(r.purpose)}</td><td>${vuEsc(r.driver)}</td>
        <td class="text-end">${vuNum(r.beforeL).toFixed(2)}</td><td class="text-end">${vuNum(r.afterL).toFixed(2)}</td>
        <td class="text-end fw-bold text-danger">${vuNum(r.used).toFixed(2)}</td>
        <td class="text-end">${vuNum(r.totalKm)}</td><td class="text-end">${vuNum(r.hsTotal)}</td>
        <td class="text-end">${r.kml === '' ? '-' : vuEsc(r.kml)}</td><td class="text-end">${r.gap === '' ? '-' : vuEsc(r.gap)}</td>
        <td>${r.linkedFuel ? `<span class="badge bg-light text-dark border">🔻 ${vuEsc(r.linkedFuel)}</span><div class="small">${vuEsc(r.prevRemaining)} → <b>${vuEsc(r.newRemaining)}</b> ລ</div>` : '<span class="text-muted small">ບໍ່ໄດ້ຫັກ</span>'}</td>
        <td><span class="badge ${bad ? 'bg-danger' : 'bg-success'}">${vuEsc(r.checkStatus)}</span></td>
        <td>${files.map(u => `<a href="${vuEsc(u)}" target="_blank" title="ເປີດໄຟລ໌"><i class="bi bi-image"></i></a>`).join(' ') || '-'}</td>
        <td>${canDel ? `<button class="btn btn-sm btn-outline-danger py-0" onclick="vuDeleteRow('${vuEsc(r.id)}')"><i class="bi bi-trash"></i></button>` : ''}</td>
      </tr>`;
    }).join('');

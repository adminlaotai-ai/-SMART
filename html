<!DOCTYPE html>
<html lang="lo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ລະບົບບັນທຶກນ້ຳມັນ SMART v5</title>
  
  <!-- CSS CDNs & Fonts -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@300;400;500;600;700&family=Phetsarath:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary-color: #1a365d;
      --sidebar-bg: #14284b;
      --secondary-color: #2a4365;
      --accent-color: #ff8c00;
      --bg-light: #eef2f7;
      --card-bg: #ffffff;
      --main-font: 'Noto Sans Lao', 'Phetsarath OT', sans-serif;
      --shadow-soft: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
      --shadow-card: 0 4px 20px rgba(0,0,0,0.03);
    }

    * { 
      font-family: var(--main-font) !important; 
      box-sizing: border-box;
    }

    body { 
      background-color: var(--bg-light);
      font-size: 13.5px;
      color: #2d3748;
    }

    /* 🔑 LOGIN PAGE DESIGN */
    #login-page { 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      min-height: 100vh; 
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); 
      padding: 15px; 
    }

    .login-card { 
      width: 100%; 
      max-width: 400px; 
      padding: 2.5rem 2rem; 
      border-radius: 20px; 
      background: rgba(255, 255, 255, 0.95); 
      backdrop-filter: blur(10px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.3); 
    }

    #main-app { display: none; }

    /* 📱 MODERN DASHBOARD LAYOUT */
    .app-layout {
      display: flex;
      min-height: calc(100vh - 30px);
      background: #f8fafc;
      border-radius: 18px;
      box-shadow: var(--shadow-soft);
      overflow: hidden;
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* SIDEBAR NAVIGATION */
    .sidebar {
      width: 260px;
      flex-shrink: 0;
      height: 100vh;
      overflow-y: auto;
      background-color: var(--primary-color);
      color: white;
      display: flex;
      flex-direction: column;
      padding: 20px 15px;
      transition: all 0.3s;
    }

    .sidebar-brand {
      font-size: 1.1rem;
      font-weight: 700;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-box {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 12px;
    }
    .sidebar-box .form-control, .sidebar-box .btn-outline-light {
      background: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.2);
      font-size: 12px;
    }
    .sidebar-box .btn-outline-light { background: transparent; color: #cbd5e1; }
    .sidebar-box .btn-outline-light:hover { background: rgba(255,255,255,0.15); color: #fff; }

    .sidebar .nav-tabs {
      border: none;
      flex-direction: column;
      gap: 6px;
      width: 100%;
    }

    .sidebar .nav-tabs .nav-link {
      color: #cbd5e1;
      font-weight: 500;
      border: none;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 10px;
      text-align: left;
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-right: 0;
      white-space: normal;
    }

    .sidebar .nav-tabs .nav-link:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: white;
    }

    .sidebar .nav-tabs .nav-link.active {
      background: linear-gradient(135deg, #ff8c00 0%, #ff7000 100%);
      color: white;
      box-shadow: 0 4px 15px rgba(255, 140, 0, 0.4);
      font-weight: 600;
    }

    /* MAIN CONTENT AREA */
    .main-content {
      flex-grow: 1;
      min-width: 0;
      background-color: #f1f5f9;
      padding: 20px;
      overflow-y: auto;
      max-height: 100vh;
    }

    .top-header {
      background: white;
      padding: 12px 20px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .user-profile-box {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--primary-color);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* CARDS & STATS */
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: var(--shadow-card);
      background: white;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .card-stat { 
      border-radius: 14px; 
      box-shadow: var(--shadow-card); 
      background: white; 
      transition: transform 0.2s, box-shadow 0.2s; 
      height: 100%; 
      border: 1px solid #f1f5f9;
    }

    .card-stat:hover { 
      transform: translateY(-3px); 
      box-shadow: 0 10px 20px rgba(0,0,0,0.06);
    }

    .dashboard-container { display: none; }
    .dashboard-container.active { display: block; }

    /* UTILITIES & FIXES */
    .table-container { 
      background: white; 
      padding: 20px; 
      border-radius: 14px; 
      box-shadow: var(--shadow-card); 
    }

    .calc-preview-box { 
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); 
      border-left: 4px solid var(--accent-color); 
      border-radius: 10px; 
      padding: 14px; 
    }

    .chart-container {
      width: 100% !important;
      position: relative;
      overflow-x: auto;
    }

    .chart-inner {
      min-width: 300px;
      height: 280px;
      position: relative;
    }

    canvas { width: 100% !important; height: 100% !important; }

    /* =====================================================================
       📱💻 RESPONSIVE LAYER — ປັບໜ້າຈໍອັດຕະໂນມັດ (ຄອມ / ແທັບເລັດ / ໂທລະສັບ)
       ≥ 992px  : ເມນູຢູ່ດ້ານຊ້າຍ (ຄອມພິວເຕີ)
       < 992px  : ແຖບເທິງ + ປຸ່ມ ☰ ເປີດເມນູເລື່ອນອອກຈາກຂ້າງ (ແທັບເລັດ / ໂທລະສັບ)
       < 768px  : ຕາຕະລາງລົດເຊົ່າ/ສ້ອມແປງ ສະແດງເປັນບັດ ອ່ານງ່າຍ
       < 576px  : ຟອມ, ປຸ່ມ, popup ເຕັມຈໍ ສຳລັບໂທລະສັບ
       ===================================================================== */
    .mobile-appbar, .drawer-backdrop, .drawer-close, .scroll-hint { display: none; }

    @media (min-width: 992px) and (max-width: 1199.98px) {
      .sidebar { width: 230px; padding: 18px 12px; }
      .main-content { padding: 16px; }
    }

    @media (max-width: 991.98px) {
      #main-app { padding: 0 !important; }
      .app-layout { display: block; min-height: 100vh; border-radius: 0; border: 0; box-shadow: none; overflow: visible; background: #f1f5f9; }

      .mobile-appbar {
        display: flex; align-items: center; gap: 10px;
        position: sticky; top: 0; z-index: 1030;
        background: var(--primary-color); color: #fff;
        padding: 10px 12px; min-height: 56px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, .25);
      }
      .mobile-appbar .appbar-btn {
        width: 42px; height: 42px; flex-shrink: 0; border: 0; border-radius: 10px;
        background: rgba(255, 255, 255, .1); color: #fff; font-size: 22px;
        display: flex; align-items: center; justify-content: center;
      }
      .mobile-appbar .appbar-btn:active { background: rgba(255, 255, 255, .25); }
      .mobile-appbar .appbar-btn:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 2px; }
      .mobile-appbar .appbar-title { min-width: 0; flex: 1; line-height: 1.25; }
      .mobile-appbar .appbar-title small { display: block; font-size: 11px; opacity: .7; }
      .mobile-appbar .appbar-title b { display: block; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      .sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; z-index: 1050;
        width: min(300px, 86vw); height: 100%; padding: 14px 12px;
        overflow-y: auto; overscroll-behavior: contain;
        transform: translateX(-105%); transition: transform .25s ease;
        box-shadow: 6px 0 24px rgba(15, 23, 42, .35);
      }
      body.drawer-open .sidebar { transform: none; }
      .sidebar-brand { display: flex; padding-bottom: 12px; margin-bottom: 12px; }
      .drawer-close {
        display: flex; margin-left: auto; width: 36px; height: 36px; border: 0; border-radius: 8px;
        background: rgba(255, 255, 255, .1); color: #fff; align-items: center; justify-content: center; font-size: 18px;
      }
      .drawer-backdrop {
        display: block; position: fixed; inset: 0; z-index: 1040;
        background: rgba(15, 23, 42, .5); opacity: 0; pointer-events: none; transition: opacity .25s ease;
      }
      body.drawer-open .drawer-backdrop { opacity: 1; pointer-events: auto; }
      body.drawer-open { overflow: hidden; }
      .sidebar .nav-tabs { flex-direction: column; flex-wrap: nowrap; overflow: visible; padding-bottom: 0; }
      .sidebar .nav-tabs .nav-link { white-space: normal; padding: 11px 14px; font-size: 14px; min-height: 44px; }
      .sidebar-box { margin-bottom: 8px; }

      .main-content { max-height: none; overflow: visible; padding: 12px; }
      .chart-inner { height: 240px; min-width: 0; }

      .scroll-hint { display: block; font-size: 11.5px; color: #64748b; text-align: right; padding: 2px 4px 4px; }
      .scroll-hint[hidden] { display: none !important; }
    }

    @media (max-width: 767.98px) {
      /* ຕາຕະລາງລົດເຊົ່າ ແລະ ສ້ອມແປງ → ບັດ */
      .rt-tbl table.resp-cards, .mt-tbl table.resp-cards { display: block; min-width: 0 !important; }
      .rt-tbl table.resp-cards thead, .mt-tbl table.resp-cards thead { display: none; }
      .rt-tbl table.resp-cards tbody, .mt-tbl table.resp-cards tbody,
      .rt-tbl table.resp-cards tfoot, .mt-tbl table.resp-cards tfoot { display: block; }
      .rt-tbl table.resp-cards tr, .mt-tbl table.resp-cards tr {
        display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
        margin: 0 0 10px; padding: 4px 0; box-shadow: 0 2px 6px rgba(15, 23, 42, .04);
      }
      .rt-tbl table.resp-cards tfoot tr, .mt-tbl table.resp-cards tfoot tr { background: #eef2f7; }
      .rt-tbl table.resp-cards td, .mt-tbl table.resp-cards td {
        display: block; position: relative; min-height: 30px;
        padding: 6px 10px 6px 42% !important; border: 0; border-bottom: 1px dashed #edf1f5;
        background: transparent !important; text-align: left !important; white-space: normal !important; word-break: break-word;
      }
      .rt-tbl table.resp-cards td:last-child, .mt-tbl table.resp-cards td:last-child { border-bottom: 0; }
      .rt-tbl table.resp-cards td::before, .mt-tbl table.resp-cards td::before {
        content: attr(data-label); position: absolute; left: 10px; top: 7px; width: calc(42% - 18px);
        font-size: 11.5px; font-weight: 600; color: #64748b; line-height: 1.3;
      }
      .rt-tbl table.resp-cards td[data-label=""], .mt-tbl table.resp-cards td[data-label=""],
      .rt-tbl table.resp-cards td[colspan], .mt-tbl table.resp-cards td[colspan] { padding-left: 10px !important; }
      .rt-tbl table.resp-cards td[data-label=""]::before, .mt-tbl table.resp-cards td[data-label=""]::before,
      .rt-tbl table.resp-cards td[colspan]::before, .mt-tbl table.resp-cards td[colspan]::before { display: none; }
      .rt-tbl table.resp-cards td .btn, .mt-tbl table.resp-cards td .btn { padding: 4px 10px !important; }
      .mt-tbl[style*="max-height"] { max-height: none !important; }
      .mt-vcard { grid-template-columns: 1fr 1fr !important; }
    }

    @media (max-width: 575.98px) {
      body { font-size: 14px; }
      .main-content { padding: 8px; }
      .main-content .card-body.p-4, .main-content .card-body.p-3 { padding: 14px !important; }
      .main-content .card-header { padding-left: 12px !important; padding-right: 12px !important; }
      .main-content .d-flex.justify-content-between, .main-content .d-flex.justify-content-end,
      .main-content .card-header.d-flex, .main-content .btn-group { flex-wrap: wrap; gap: 8px; }
      .main-content .table-container { padding: 12px; }
      .main-content h4, .main-content .h4 { font-size: 1.15rem; }
      .main-content h5, .main-content .h5 { font-size: 1.05rem; }

      /* ຊ່ອງປ້ອນຂໍ້ມູນ 16px — ບໍ່ໃຫ້ iPhone ຊູມເອງເວລາແຕະ */
      .main-content .form-control, .main-content .form-select, .main-content textarea,
      .modal .form-control, .modal .form-select { font-size: 16px; }
      .main-content .btn:not(.py-0) { min-height: 38px; }

      /* ຟອມລົດເຊົ່າ/ສ້ອມແປງ: 2 ຖັນ, ຊ່ອງກວ້າງເຕັມແຖວ */
      .rt-grid, .mt-grid { grid-template-columns: 1fr 1fr !important; }
      .rt-grid > [style*="span 2"], .rt-grid > .rt-wide, .mt-grid > .mt-wide, .mt-grid > .mt-span2 { grid-column: 1 / -1 !important; }
      .rt-filters > label, .mt-filters > label { flex: 1 1 calc(50% - 10px) !important; max-width: none !important; }
      .rt-filters > .btn, .mt-filters > .btn { flex: 1 1 auto; }
      .rt-cards, .mt-cards { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
      .rt-card .v, .mt-card .v { font-size: 19px !important; }
      .rt-box, .mt-box { padding: 12px !important; }
      .mt-prow { grid-template-columns: 1fr 1fr !important; }
      .mt-prow .pn { grid-column: 1 / -1; }

      /* Popup ເຕັມຈໍ */
      .modal-dialog { margin: 0; max-width: none; min-height: 100%; }
      .modal-dialog-centered { align-items: stretch; }
      .modal-content { border-radius: 0 !important; min-height: 100vh; }
      .modal-header { border-radius: 0 !important; position: sticky; top: 0; z-index: 2; }
      .modal-body.p-4 { padding: 14px !important; }
      .swal2-popup { width: calc(100vw - 24px) !important; }
    }

    @media print {
      .mobile-appbar, .drawer-backdrop, .scroll-hint { display: none !important; }
    }

    /* Print styles */
    .print-only { display: none; }
    @media print {
      body * { visibility: hidden; }
      #daily-report-content, #daily-report-content *,
      #monthly-report-content, #monthly-report-content *,
      #yearly-report-content, #yearly-report-content * { visibility: visible; }
      #daily-report-content, #monthly-report-content, #yearly-report-content { position: absolute; top: 0; left: 0; width: 100%; }
      .no-print { display: none !important; }
      .print-only { display: block !important; }

      .card { border: 1px solid #999 !important; box-shadow: none !important; break-inside: avoid; }
      .card-header { background: #1a365d !important; color: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .table thead th { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .btn { display: none !important; }

      .print-report-header { text-align: center; border-bottom: 3px solid #1a365d; padding-bottom: 10px; margin-bottom: 16px; }
      .print-report-header h2 { margin: 0; color: #1a365d; font-size: 20px; font-weight: 700; }
      .print-report-header .sub { font-size: 13px; color: #333; margin-top: 4px; }

      .print-signature-block { break-inside: avoid; page-break-inside: avoid; }
      .print-sig-img { max-height: 90px; max-width: 100%; object-fit: contain; }
      .print-sig-name { font-weight: 700; margin-top: 6px; font-size: 13px; }
      .print-sig-line { border-top: 1px solid #333; margin-top: 60px; padding-top: 4px; font-size: 12px; color: #333; }

      @page { size: A4; margin: 14mm; }
    }
  </style>
</head>
<body>

<!-- 🔑 LOGIN PAGE -->
<div id="login-page">
  <div class="login-card text-center">
    <div class="mb-3">
      <div style="font-size: 3.5rem; background: #fff3e0; width: 80px; height: 80px; line-height: 80px; border-radius: 50%; margin: 0 auto; box-shadow: 0 4px 10px rgba(255,140,0,0.2);">⛽</div>
      <h4 class="fw-bold mt-3" style="color: var(--primary-color);">ລະບົບບັນທຶກນ້ຳມັນ</h4>
      <p class="text-muted small">ກະລຸນາເຂົ້າລະບົບເພື່ອດຳເນີນການ</p>
    </div>
    <form id="loginForm" onsubmit="handleLogin(event)">
      <div class="mb-3 text-start">
        <label class="form-label fw-bold small">Email</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
          <input type="email" class="form-control border-start-0 ps-0" id="username" required autocomplete="username" placeholder="name@example.com">
        </div>
      </div>
      <div class="mb-4 text-start">
        <label class="form-label fw-bold small">Password</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
          <input type="password" class="form-control border-start-0 ps-0" id="password" required autocomplete="current-password">
        </div>
      </div>
      <div class="d-grid">
        <button type="submit" id="loginBtn" class="btn text-white fw-bold py-2 shadow-sm" style="background: linear-gradient(135deg, #1a365d 0%, #2a4365 100%); font-size: 14.5px; border-radius: 10px;">🔓 ເຂົ້າສູ່ລະບົບ</button>
      </div>
      <p class="text-muted small mt-3 mb-0" style="font-size: 11px;">Smart Fuel System v5</p>
    </form>     
  </div>
</div>

<!-- 📱 MAIN APP (DASHBOARD LAYOUT) -->
<div id="main-app" class="container-fluid p-2 p-md-3">
  <!-- 📱 ແຖບເທິງ (ສະແດງສະເພາະໂທລະສັບ/ແທັບເລັດ) -->
  <header class="mobile-appbar no-print">
    <button type="button" class="appbar-btn" id="appbarMenuBtn" onclick="RESP.toggle()" aria-label="ເປີດເມນູ" aria-expanded="false" aria-controls="appSidebar"><i class="bi bi-list"></i></button>
    <div class="appbar-title"><small><i class="bi bi-fuel-pump-fill text-warning"></i> SMART FUEL v5</small><b id="appbarTitle">ຟອມບັນທຶກນ້ຳມັນອອກ</b></div>
  </header>
  <div class="drawer-backdrop no-print" onclick="RESP.close()"></div>
  <div class="app-layout">
    
    <!-- SIDEBAR -->
    <div class="sidebar no-print" id="appSidebar">
      <div class="sidebar-brand">
        <i class="bi bi-fuel-pump-fill text-warning fs-4"></i>
        <span>SMART FUEL v5</span>
        <button type="button" class="drawer-close" onclick="RESP.close()" aria-label="ປິດເມນູ"><i class="bi bi-x-lg"></i></button>
      </div>

      <!-- USER PROFILE -->
      <div class="sidebar-box mb-2">
        <div class="d-flex align-items-center gap-2">
          <div class="position-relative" style="width:42px;height:42px;flex-shrink:0;">
            <div id="sidebarAvatarIcon" class="bg-light rounded-circle text-primary d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
              <i class="bi bi-person-fill fs-5"></i>
            </div>
            <img id="sidebarProfilePhoto" src="" style="display:none;position:absolute;top:0;left:0;width:42px;height:42px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,0.3);">
            <button type="button" class="btn btn-warning rounded-circle position-absolute p-0 d-flex align-items-center justify-content-center"
                    style="width:18px;height:18px;bottom:-2px;right:-2px;border:2px solid var(--primary-color);"
                    title="ປ່ຽນຮູບໂປຣໄຟລ໌" onclick="document.getElementById('profilePhotoInput').click()">
              <i class="bi bi-camera-fill" style="font-size:9px;"></i>
            </button>

    var chaps = []; SLIDES.forEach(function (s, i) { if (!chaps.some(function (c) { return c[0] === s.chap; })) chaps.push([s.chap, i]); });
    $('svChapters').innerHTML = chaps.map(function (c) { return '<button type="button" data-c="' + esc(c[0]) + '" onclick="GUIDE.go(' + c[1] + ')">' + esc(c[0]) + '</button>'; }).join('');
    // ສຽງບັນຍາຍ: ເປີດສະເພາະເມື່ອເຄື່ອງມີສຽງພາສາລາວ
    function findVoice() { try { var v = (window.speechSynthesis ? speechSynthesis.getVoices() : []).filter(function (x) { return /^lo/i.test(x.lang); })[0]; if (v) { P.laoVoice = v; $('svVoice').style.display = ''; } } catch (e) {} }
    findVoice(); if (window.speechSynthesis) speechSynthesis.onvoiceschanged = findVoice;
    // ປັດຊ້າຍ-ຂວາ
    var sx = null;
    $('svStage').addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
    $('svStage').addEventListener('touchend', function (e) { if (sx === null) return; var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); } sx = null; }, { passive: true });
    document.addEventListener('keydown', function (e) {
      if (!$('guide-content').classList.contains('active') || !document.querySelector('#guide-content section[data-gsec="slides"].on')) return;

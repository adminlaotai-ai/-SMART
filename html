  /* ---------- ລາຍງານ ---------- */
  function reportRows() {
    var f = $('rtRpFrom').value || '0000-00', t = $('rtRpTo').value || '9999-99', by = $('rtRpBy').value, g = {};
    function keyOf(c, site) { return by === 'supplier' ? sup(c.supplierId).name : by === 'vehicle' ? c.plate + (c.vehicle ? ' ' + c.vehicle : '') : (site || c.site || '(ບໍ່ລະບຸ)'); }
    function get(k) { return g[k] || (g[k] = { k: k, veh: {}, hrs: 0, wd: {}, bd: {}, fuel: 0, net: 0, paid: 0, billedHrs: 0, hourlyWorked: 0 }); }
    S.d.logs.forEach(function (l) {
      var m = String(l.date).slice(0, 7); if (m < f || m > t) return;
      var c = ct(l.contractId); if (!c.id) return;
      var r = get(keyOf(c, l.site)); r.veh[c.id] = 1;
      if (l.status === 'work') { r.hrs += Number(l.hours || 0); r.wd[c.id + l.date] = 1; if (c.rateType === 'hour') r.hourlyWorked += Number(l.hours || 0); }
      if (l.status === 'breakdown') r.bd[c.id + l.date] = 1;
    });
    S.d.invoices.forEach(function (i) {
      if (i.month < f || i.month > t) return;
      var c = ct(i.contractId); if (!c.id) return;
      var r = get(keyOf(c, c.site)); r.veh[c.id] = 1;
      r.net += Number(i.netLAK || 0); r.paid += paidOf(i.id); r.fuel += Number(i.fuelLiters || 0);
      if (c.rateType === 'hour') r.billedHrs += Number(i.qty || 0);
    });
    return Object.keys(g).map(function (k) {
      var r = g[k];
      return { k: k, veh: Object.keys(r.veh).length, hrs: r.hrs, wd: Object.keys(r.wd).length, bd: Object.keys(r.bd).length, fuel: r.fuel, net: r.net, paid: r.paid,
        owe: Math.max(0, r.net - r.paid), util: r.billedHrs > 0 ? r.hourlyWorked / r.billedHrs : null };
    }).sort(function (a, b) { return b.net - a.net; });
  }
  function renderReport() {
    if (!S.d) return;
    var rows = reportRows(), by = $('rtRpBy').value, T = { hrs: 0, wd: 0, bd: 0, fuel: 0, net: 0, paid: 0, owe: 0 };
    $('rtRpH').textContent = by === 'supplier' ? 'ຜູ້ໃຫ້ເຊົ່າ' : by === 'vehicle' ? 'ລົດ' : 'ສະໜາມ';
    $('rtRpBody').innerHTML = rows.length ? rows.map(function (r) {
      Object.keys(T).forEach(function (k) { T[k] += r[k]; });
      var u = r.util == null ? '-' : Math.round(r.util * 100) + '%';

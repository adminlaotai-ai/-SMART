  function toggleUserPassword(username) {
    const span = document.getElementById('pwd_' + username);
    const icon = document.getElementById('pwd_icon_' + username);
    if (!span) return;
    const isShown = span.dataset.shown === '1';
    if (isShown) {
      span.textContent = '••••••'; span.dataset.shown = '0';
      if (icon) { icon.classList.remove('bi-eye-slash'); icon.classList.add('bi-eye'); }
      return;
    }
    if (revealedPasswords[username]) {
      span.textContent = revealedPasswords[username]; span.dataset.shown = '1';
      if (icon) { icon.classList.remove('bi-eye'); icon.classList.add('bi-eye-slash'); }
      return;
    }
    google.script.run.withSuccessHandler((res) => {
      if (res.success) {
        revealedPasswords[username] = res.password;
        span.textContent = res.password; span.dataset.shown = '1';
        if (icon) { icon.classList.remove('bi-eye'); icon.classList.add('bi-eye-slash'); }
      } else { Swal.fire('ຜິດພາດ', res.error, 'error'); }

    const headers = ['ID', 'ວັນທີເວລາ', 'ສະໜາມ', 'ທະບຽນລົດ', 'ປະເພດ', 'ລຸ້ນ', 'ຈຸດປະສົງ',
      'ກ່ອນໃຊ້ (CM)', 'ກ່ອນໃຊ້ (ລິດ)', 'ຫຼັງໃຊ້ (CM)', 'ຫຼັງໃຊ້ (ລິດ)', 'ໃຊ້ໄປ (ລິດ)',
      'KM ກ່ອນ', 'KM ຫຼັງ', 'ໄລຍະທາງ (KM)', 'ເລີ່ມ (Hs)', 'ຢຸດ (Hs)', 'ລວມ Hs', 'KM/L', 'L/Hs',

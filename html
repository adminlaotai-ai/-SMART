    const fmt = (n) => Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    data.forEach(r => {
      const tr = document.createElement('tr');
      const remainingClass = r.remaining < 0 ? 'text-danger' : 'text-primary';
      tr.innerHTML = `
        <td class="text-start fw-bold">${r.site}</td>
        <td class="text-end text-success fw-bold">${fmt(r.imported)}</td>
        <td class="text-end text-warning fw-bold">${fmt(r.used)}</td>
        <td class="text-end ${remainingClass} fw-bold">${fmt(r.remaining)}${r.remaining < 0 ? ' ⚠️' : ''}</td>
        <td class="text-muted small">${r.threshold ? fmt(r.threshold) : '-'}</td>
        <td>${r.remaining <= 0 ? '<span class="badge bg-danger">🚨 ໝົດ</span>'
            : (r.threshold && r.remaining <= r.threshold) ? '<span class="badge bg-warning text-dark">⚠️ ໃກ້ໝົດ</span>'
            : '<span class="badge bg-success">ປົກກະຕິ</span>'}</td>

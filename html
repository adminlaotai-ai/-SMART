      <div id="guide-content" class="dashboard-container">
        <style>
          #guide-content{--g-navy:#1a365d;--g-orange:#ff8c00;--g-ink:#1f2d3d;--g-muted:#64748b;--g-line:#e2e8f0;--g-soft:#f1f5f9}

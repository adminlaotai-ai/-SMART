  // 📊 ລວມຂໍ້ມູນດັສບອດ ຈາກ "ນ້ຳມັນທີ່ໃຊ້ຕົວຈິງ" (consumptionEvents ຈາກເຊີບເວີ: ຕື່ມນ້ຳມັນ + ໃຊ້ລົດ)
  // ຖ້າເຊີບເວີບໍ່ໄດ້ສົ່ງມາ (ເວີຊັນເກົ່າ) ຈະໃຊ້ວິທີເດີມ (ຖັນ "ລວມເປັນລິດ")
  function buildDashboardStats_(rawData) {
    const s = { records: 0, usageCount: 0, totalFuel: 0, totalFilled: 0, carFuel: {}, carKm: {}, carHs: {}, siteFuel: {} };
    const add = (m, k, v) => { m[k] = (m[k] || 0) + v; };
    const events = globalData && Array.isArray(globalData.consumptionEvents) ? globalData.consumptionEvents : null;
    if (events) {
      events.forEach(e => {
        const car = e.car || 'Unknown', st = e.st || 'Unknown';
        if (e.type === 'use') s.usageCount++; else s.records++;
        s.totalFuel += Number(e.L) || 0;
        s.totalFilled += Number(e.filled) || 0;
        add(s.carFuel, car, Number(e.L) || 0);
        add(s.carKm, car, Number(e.km) || 0);
        add(s.carHs, car, Number(e.hs) || 0);
        add(s.siteFuel, st, Number(e.L) || 0);
      });
    } else {
      (rawData || []).forEach(r => {
        const fuel = parseFloat(r[10]) || 0, car = r[2] || 'Unknown', st = r[1] || 'Unknown';
        s.records++; s.totalFuel += fuel; s.totalFilled += parseFloat(r[9]) || 0;
        add(s.carFuel, car, fuel); add(s.carKm, car, parseFloat(r[18]) || 0);
        add(s.carHs, car, parseFloat(r[15]) || 0); add(s.siteFuel, st, fuel);
      });
    }
    return s;
  }

  function updateDashboard(rawData) {
    if (!rawData) return;
    const s = buildDashboardStats_(rawData);

    document.getElementById('stat-total-records').innerText = s.records + (s.usageCount ? ` (+${s.usageCount} ໃຊ້ລົດ)` : '');
    document.getElementById('stat-total-used').innerText = s.totalFuel.toFixed(2);
    const filledEl = document.getElementById('stat-total-filled');
    if (filledEl) filledEl.innerText = `ຕື່ມເຂົ້າລົດທັງໝົດ: ${s.totalFilled.toFixed(2)} ລິດ`;

    let kmListHtml = '';
    Object.keys(s.carKm).forEach(c => { kmListHtml += `<div>• ${c}: ${s.carKm[c].toFixed(0)} KM</div>`; });
    document.getElementById('stat-total-km-list').innerHTML = kmListHtml || 'ບໍ່ມີຂໍ້ມູນ';

    let hoursListHtml = '';
    Object.keys(s.carHs).forEach(c => { hoursListHtml += `<div>• ${c}: ${s.carHs[c].toFixed(1)} Hs</div>`; });
    document.getElementById('stat-total-hours-list').innerHTML = hoursListHtml || 'ບໍ່ມີຂໍ້ມູນ';

    let stListHtml = '';
    Object.keys(s.siteFuel).forEach(st => { stListHtml += `<div>• ${st}: ${s.siteFuel[st].toFixed(2)} L</div>`; });
    document.getElementById('stat-station-fuel-list').innerHTML = stListHtml || 'ບໍ່ມີຂໍ້ມູນ';
  }


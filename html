  // ==========================================
  // 🔔 ຕັ້ງຄ່າແຈ້ງເຕືອນນ້ຳມັນໃກ້ໝົດ (Admin)
  // ==========================================
  function lsEsc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

  function lsLoad() {
    const hourSel = document.getElementById('lsHour');
    if (hourSel && !hourSel.options.length) {
      for (let h = 0; h < 24; h++) hourSel.add(new Option(String(h).padStart(2, '0') + ':00', h));
    }
    google.script.run.withSuccessHandler(res => {
      if (!res || !res.success) return;
      const s = res.settings;
      document.getElementById('lsThreshold').value = s.threshold;
      document.getElementById('lsEmails').value = (s.emails || []).join('\n');
      document.getElementById('lsLine').checked = s.lineEnabled;
      document.getElementById('lsEmail').checked = s.emailEnabled;
      document.getElementById('lsDaily').checked = s.dailyReminder;
      document.getElementById('lsHour').value = res.dailyTriggerHour;
      lsShowTrigger(res.dailyTriggerActive, res.dailyTriggerHour);
      const box = document.getElementById('lsStationList');
      box.innerHTML = (res.stations || []).map(st => `
        <div class="col-6 col-md-4 col-lg-3">
          <div class="input-group input-group-sm">
            <span class="input-group-text text-truncate" style="max-width:60%;" title="${lsEsc(st)}">${lsEsc(st)}</span>
            <input type="number" class="form-control ls-station" data-station="${lsEsc(st)}" min="1" step="any" placeholder="${lsEsc(s.threshold)}" value="${s.stationThresholds[st] || ''}">
          </div>
        </div>`).join('') || '<div class="text-muted small">ຍັງບໍ່ມີສະຖານທີ່</div>';
    }).withFailureHandler(onFailure).getLowStockSettings(currentUser.username);
  }

  function lsShowTrigger(active, hour) {
    const el = document.getElementById('lsTriggerStatus');
    el.className = 'badge ' + (active ? 'bg-success' : 'bg-secondary');
    el.textContent = active ? `ເປີດຢູ່ (${String(hour).padStart(2, '0')}:00)` : 'ປິດຢູ່';
  }

  function lsSave() {
    const stationThresholds = {};
    document.querySelectorAll('.ls-station').forEach(inp => { if (Number(inp.value) > 0) stationThresholds[inp.dataset.station] = Number(inp.value); });
    const payload = {
      threshold: document.getElementById('lsThreshold').value,
      emails: document.getElementById('lsEmails').value.split(/[\s,;]+/).filter(Boolean),
      stationThresholds: stationThresholds,
      lineEnabled: document.getElementById('lsLine').checked,
      emailEnabled: document.getElementById('lsEmail').checked,
      dailyReminder: document.getElementById('lsDaily').checked
    };
    Swal.fire({ title: 'ກຳລັງບັນທຶກ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    google.script.run.withSuccessHandler(res => {
      if (!res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', res.error, 'error'); return; }
      const low = (res.results || []).filter(r => r.low);
      Swal.fire('ບັນທຶກແລ້ວ', low.length
        ? 'ສະຖານທີ່ທີ່ຕ່ຳກວ່າເກນ: ' + low.map(r => `${lsEsc(r.station)} (${Number(r.remaining).toFixed(0)} ລ)`).join(', ')
        : 'ທຸກສະຖານທີ່ຍັງມີນ້ຳມັນເກີນເກນ', 'success');
      loadStockSummary();
    }).withFailureHandler(onFailure).saveLowStockSettings(currentUser.username, payload);
  }

  function lsTest() {
    Swal.fire({ title: 'ກຳລັງສົ່ງທົດສອບ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    google.script.run.withSuccessHandler(res => {
      if (!res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', res.error, 'error'); return; }
      Swal.fire('ສົ່ງແລ້ວ', res.sentTo.length
        ? 'ສົ່ງໄປ: ' + lsEsc(res.sentTo.join(' • ')) + `<br><small class="text-muted">ໂຄຕ້າອີເມວເຫຼືອມື້ນີ້: ${res.quotaLeft}</small>`
        : 'ບໍ່ມີຊ່ອງທາງທີ່ເປີດ — ກະລຸນາບັນທຶກການຕັ້ງຄ່າ (ອີເມວ/LINE) ກ່ອນ', res.sentTo.length ? 'success' : 'warning');
    }).withFailureHandler(onFailure).sendTestLowStockAlert(currentUser.username);
  }

  function lsSetTrigger(enable) {
    const hour = document.getElementById('lsHour').value;
    google.script.run.withSuccessHandler(res => {
      if (!res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', res.error, 'error'); return; }
      lsShowTrigger(res.active, hour);
      Swal.fire(enable ? 'ເປີດການກວດປະຈຳວັນແລ້ວ' : 'ປິດການກວດປະຈຳວັນແລ້ວ', '', 'success');
    }).withFailureHandler(onFailure).setLowStockDailyTrigger(currentUser.username, enable, hour);
  }

  // ==========================================
  // 👥 Dropdown ໂຊເຟີ / ຜູ້ຮັບຜິດຊອບໂຄງການ (ໃຊ້ຮ່ວມກັນທຸກໜ້າ: select.people-select[data-people])
  // ==========================================
  let peopleLists = { driver: [], supervisor: [] };
  const PEOPLE_LABELS = {
    driver: { placeholder: '-- ເລືອກໂຊເຟີ --', title: '➕ ເພີ່ມຊື່ໂຊເຟີລົດ', input: 'ຊື່ ແລະ ນາມສະກຸນ ໂຊເຟີ' },
    supervisor: { placeholder: '-- ເລືອກຜູ້ຮັບຜິດຊອບ --', title: '➕ ເພີ່ມຊື່ຜູ້ຮັບຜິດຊອບ / ຫົວໜ້າໂຄງການ', input: 'ຊື່ ແລະ ນາມສະກຸນ' }
  };

  function peopleEsc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

  function populatePeopleSelects(lists) {
    if (lists) peopleLists = { driver: lists.drivers || [], supervisor: lists.supervisors || [] };
    document.querySelectorAll('select.people-select').forEach(sel => {
      const type = sel.dataset.people;
      const keep = sel.value;
      sel.innerHTML = `<option value="" selected>${PEOPLE_LABELS[type].placeholder}</option>`;
      (peopleLists[type] || []).forEach(n => sel.add(new Option(n, n)));
      if (keep) setPeopleValue(sel.id, keep);
    });
  }

  // ຕັ້ງຄ່າໃຫ້ dropdown — ຖ້າຊື່ນັ້ນບໍ່ມີໃນລາຍການ (ເຊັ່ນ ຂໍ້ມູນເກົ່າ) ຈະເພີ່ມໃສ່ໃຫ້ເພື່ອບໍ່ໃຫ້ຫາຍ
  function setPeopleValue(id, val) {
    const sel = document.getElementById(id);
    if (!sel) return;
    val = (val || '').toString();
    if (val && !Array.from(sel.options).some(o => o.value === val)) sel.add(new Option(val, val));
    sel.value = val;
  }

  function peopleOptionsHtml(type, current) {
    const list = (peopleLists[type] || []).slice();
    if (current && !list.includes(current)) list.unshift(current);
    return `<option value="">${PEOPLE_LABELS[type].placeholder}</option>` +
      list.map(n => `<option value="${peopleEsc(n)}"${n === current ? ' selected' : ''}>${peopleEsc(n)}</option>`).join('');
  }

  function promptAddPerson(type, targetId) {
    Swal.fire({
      title: PEOPLE_LABELS[type].title,
      input: 'text',
      inputPlaceholder: PEOPLE_LABELS[type].input,
      showCancelButton: true,
      confirmButtonText: '💾 ເພີ່ມ',
      cancelButtonText: 'ຍົກເລີກ',
      confirmButtonColor: '#198754',
      inputValidator: v => (!v || !v.trim()) ? 'ກະລຸນາປ້ອນຊື່' : undefined
    }).then(res => {
      if (!res.isConfirmed || !res.value) return;
      const name = res.value.trim();
      Swal.fire({ title: 'ກຳລັງບັນທຶກ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      google.script.run.withSuccessHandler(r => {
        if (!r || !r.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', r ? r.error : '', 'error'); return; }
        populatePeopleSelects(r.people);
        setPeopleValue(targetId, r.name);
        Swal.fire({ icon: 'success', title: r.existed ? 'ມີຊື່ນີ້ຢູ່ແລ້ວ — ເລືອກໃຫ້ແລ້ວ' : 'ເພີ່ມຊື່ສຳເລັດ', timer: 1300, showConfirmButton: false });
      }).withFailureHandler(onFailure).addPerson(currentUser ? currentUser.username : '', type, name);
    });
  }

  // ==========================================
  // 🚗 ລົດປະຈຳສະໜາມ — ກວດສະໜາມໃນຟອມ + ໜ້າຈັດການ (Admin)
  // ==========================================
  function vsMap() { return (globalData && globalData.vehicleStations) || {}; }
  function vsEsc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

  // ສະແດງສະຖານະໃຕ້ຊ່ອງສະໜາມ; ຄືນ { home, ok }
  function stationGuardUpdate(carId, locId, boxId) {
    const car = document.getElementById(carId), loc = document.getElementById(locId), box = document.getElementById(boxId);
    if (!car || !loc || !box) return { ok: true };
    const home = vsMap()[(car.value || '').trim()];
    if (!home) { box.innerHTML = ''; return { ok: true }; }
    if (loc.value === home) {
      box.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> ລົດປະຈຳສະໜາມ "${vsEsc(home)}" — ຖືກຕ້ອງ</span>`;
      return { home, ok: true };
    }
    box.innerHTML = `<div class="alert alert-danger py-1 px-2 mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> ໃສ່ສະໜາມບໍ່ຖືກຕ້ອງ! ລົດນີ້ປະຈຳສະໜາມ "${vsEsc(home)}"` +
      (Array.from(loc.options).some(o => o.value === home)
        ? ` <button type="button" class="btn btn-sm btn-light py-0 ms-1" onclick="document.getElementById('${locId}').value='${vsEsc(home).replace(/'/g, "\\'")}';stationGuardUpdate('${carId}','${locId}','${boxId}')">ປ່ຽນເປັນ "${vsEsc(home)}"</button>`
        : ' (ທ່ານບໍ່ມີສິດບັນທຶກສະໜາມນີ້ — ກະລຸນາຕິດຕໍ່ Admin)') + `</div>`;
    return { home, ok: false };
  }

  // ເລືອກລົດ → ເລືອກສະໜາມປະຈຳໃຫ້ອັດຕະໂນມັດ
  function stationGuardOnCar(carId, locId, boxId) {
    const home = vsMap()[(document.getElementById(carId).value || '').trim()];
    const loc = document.getElementById(locId);
    if (home && Array.from(loc.options).some(o => o.value === home)) loc.value = home;
    stationGuardUpdate(carId, locId, boxId);
  }

  // ກວດກ່ອນບັນທຶກ: ຖ້າຜິດ → ແຈ້ງເຕືອນ ແລະ ໃຫ້ເລືອກປ່ຽນເປັນສະໜາມທີ່ຖືກ
  function stationGuardCheck(carId, locId, boxId, retry) {
    const g = stationGuardUpdate(carId, locId, boxId);
    if (g.ok) return true;
    const loc = document.getElementById(locId);
    const canSwitch = Array.from(loc.options).some(o => o.value === g.home);
    Swal.fire({
      icon: 'error',
      title: '🚫 ໃສ່ສະໜາມບໍ່ຖືກຕ້ອງ',
      html: `ລົດ <b>${vsEsc(document.getElementById(carId).value)}</b> ເປັນລົດປະຈຳສະໜາມ <b class="text-primary">${vsEsc(g.home)}</b><br>` +
            `ແຕ່ທ່ານເລືອກ <b class="text-danger">${vsEsc(loc.value || '-')}</b><br><small class="text-muted">ນ້ຳມັນຕ້ອງຫັກຈາກສະໜາມປະຈຳຂອງລົດເທົ່ານັ້ນ</small>`,
      showCancelButton: canSwitch,
      showConfirmButton: canSwitch,
      confirmButtonText: `✅ ປ່ຽນເປັນ "${g.home}" ແລ້ວບັນທຶກ`,
      cancelButtonText: 'ກັບໄປແກ້ໄຂ',
      confirmButtonColor: '#198754'
    }).then(r => {
      if (r.isConfirmed && canSwitch) { loc.value = g.home; stationGuardUpdate(carId, locId, boxId); retry(); }
    });
    return false;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const bind = (carId, locId, boxId) => {
      const car = document.getElementById(carId), loc = document.getElementById(locId);
      if (car) car.addEventListener('change', () => stationGuardOnCar(carId, locId, boxId));
      if (loc) loc.addEventListener('change', () => stationGuardUpdate(carId, locId, boxId));
    };
    bind('carnumber', 'location', 'locationGuard');
    bind('vuCarnumber', 'vuLocation', 'vuLocationGuard');
  });

  // ---- ໜ້າຈັດການ (Admin) ----
  let vsData = { map: {}, usage: {}, stations: [] };
  let vsDraft = {};

  function vsLoad() {
    document.getElementById('vsBody').innerHTML = '<tr><td colspan="3" class="text-center text-muted">ກຳລັງໂຫຼດ...</td></tr>';
    google.script.run.withSuccessHandler(res => {
      if (!res || !res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', res ? res.error : '', 'error'); return; }
      vsData = res;
      vsDraft = Object.assign({}, res.map);
      vsRender();
    }).withFailureHandler(onFailure).getVehicleStationAdmin(currentUser.username);
  }

  function vsPlates() {
    const set = new Set();
    Array.from(document.getElementById('carnumber').options).forEach(o => { if (o.value) set.add(o.value); });
    Object.keys(vsData.usage || {}).forEach(p => set.add(p));
    Object.keys(vsData.map || {}).forEach(p => set.add(p));
    return Array.from(set).sort((a, b) => a.localeCompare(b, 'lo'));
  }

  function vsTop(plate) {
    const u = (vsData.usage || {})[plate] || {};
    return Object.keys(u).sort((a, b) => u[b] - u[a])[0] || '';
  }

  function vsRender() {
    const q = (document.getElementById('vsSearch').value || '').toLowerCase();
    const plates = vsPlates();
    const stations = vsData.stations || [];
    document.getElementById('vsSummary').innerText = `ກຳນົດແລ້ວ ${plates.filter(p => vsDraft[p]).length} / ${plates.length} ຄັນ`;
    document.getElementById('vsBody').innerHTML = plates.filter(p => p.toLowerCase().includes(q)).map(p => {
      const u = (vsData.usage || {})[p] || {};
      const hist = Object.keys(u).sort((a, b) => u[b] - u[a]).map(s =>
        `<span class="badge ${s === vsDraft[p] ? 'bg-success' : 'bg-light text-dark border'} me-1">${vsEsc(s)}: ${u[s]}</span>`).join('') || '<span class="text-muted small">-</span>';
      const opts = ['<option value="">— ບໍ່ກຳນົດ (ທຸກສະໜາມ) —</option>']
        .concat(stations.map(s => `<option value="${vsEsc(s)}"${vsDraft[p] === s ? ' selected' : ''}>${vsEsc(s)}</option>`)).join('');
      return `<tr class="${vsDraft[p] ? '' : 'table-light'}"><td class="fw-bold">${vsEsc(p)}</td>
        <td><select class="form-select form-select-sm" data-plate="${vsEsc(p)}" onchange="vsDraft[this.dataset.plate]=this.value;vsRender()">${opts}</select></td>
        <td>${hist}</td></tr>`;
    }).join('') || '<tr><td colspan="3" class="text-center text-muted">ບໍ່ພົບ</td></tr>';
  }

  function vsApplySuggestions() {
    let n = 0;
    vsPlates().forEach(p => { if (!vsDraft[p]) { const t = vsTop(p); if (t) { vsDraft[p] = t; n++; } } });
    vsRender();
    Swal.fire({ icon: 'info', title: `ເລືອກໃຫ້ ${n} ຄັນ`, text: 'ກະລຸນາກວດ ແລ້ວກົດ "ບັນທຶກການກຳນົດ"', timer: 2000, showConfirmButton: false });
  }

  function vsSave() {
    Swal.fire({ title: 'ກຳລັງບັນທຶກ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    google.script.run.withSuccessHandler(res => {
      if (!res.success) { Swal.fire('ເກີດຂໍ້ຜິດພາດ', res.error, 'error'); return; }
      globalData.vehicleStations = res.map;
      vsData.map = res.map;
      Swal.fire('ບັນທຶກແລ້ວ', `ກຳນົດລົດປະຈຳສະໜາມ ${res.count} ຄັນ`, 'success');
      vsRender();
    }).withFailureHandler(onFailure).saveVehicleStations(currentUser.username, vsDraft);
  }
</script>
<!-- ================= 🚜 RENTAL MODULE SCRIPT (ລົດເຊົ່າພາກສະໜາມ) ================= -->
<script>
var RT = (function () {
  var S = { d: null, sec: 'contracts', billing: [], billingMonth: '' };

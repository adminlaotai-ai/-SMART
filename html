  // ---- ຄໍລຳ "ຫັກໃຊ້ລົດ" ໃນຕາຕະລາງນ້ຳມັນອອກ ----
  const VU_DEDUCT_HEADERS = ['ກ່ອນຫັກໃຊ້ລົດ (ລິດ)', 'ໃຊ້ລົດ (ຄັ້ງ)', 'ຫັກໃຊ້ລົດ (ລິດ)'];
  function vuDeductFor(row) {
    const map = (globalData && globalData.usageDeductions) || {};
    return map[`${row[0]}|${row[1]}|${String(row[2] || '').trim()}`] || null;
  }
  function vuDeductCellsHtml(row) {
    const d = vuDeductFor(row);
    if (!d) return '<td class="text-muted">-</td><td class="text-muted">-</td><td class="text-muted">-</td>';
    return `<td>${Number(d.base).toFixed(2)}</td>
      <td><span class="badge bg-success">${d.count}</span></td>
      <td class="fw-bold text-danger">-${Number(d.used).toFixed(2)}</td>`;

          #guide-content .g-steps li{counter-increment:st;position:relative;padding:2px 0 2px 38px;line-height:1.55}
          #guide-content .g-steps li::before{content:counter(st);position:absolute;left:0;top:0;width:26px;height:26px;border-radius:50%;background:var(--g-navy);color:#fff;font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:center}
          #guide-content .g-note{border-radius:10px;padding:8px 12px;font-size:13px;margin-top:8px;max-width:80ch}

  var RATE = { hour: 'ລາຍຊົ່ວໂມງ', day: 'ລາຍວັນ', month: 'ລາຍເດືອນ' };
  var UNIT = { hour: 'ຊມ', day: 'ມື້', month: 'ເດືອນ' };
  var DAY = { work: ['ເຮັດວຽກ', 'p-ok'], standby: ['ລໍຖ້າວຽກ', 'p-info'], breakdown: ['ລົດເສຍ', 'p-bad'], off: ['ມື້ພັກ', 'p-mute'] };
  var CST = { active: ['ໃຊ້ງານ', 'p-ok'], expiring: ['ໃກ້ໝົດ', 'p-warn'], expired: ['ໝົດອາຍຸ', 'p-bad'], upcoming: ['ຍັງບໍ່ເລີ່ມ', 'p-info'], closed: ['ປິດແລ້ວ', 'p-mute'] };
  var TITLES = { contracts: '📑 ຜູ້ໃຫ້ເຊົ່າ ແລະ ສັນຍາເຊົ່າລົດ', logs: '📋 ບັນທຶກລົດເຊົ່າປະຈຳວັນ', billing: '🧮 ຄິດໄລ່ຄ່າເຊົ່າປະຈຳເດືອນ', payments: '💵 ການຈ່າຍຄ່າເຊົ່າ', report: '📊 ລາຍງານລົດເຊົ່າ' };
  var ALERT_DAYS = 15;

  function $(id) { return document.getElementById(id); }
  function fmt(n) { return Math.round(Number(n) || 0).toLocaleString('en-US'); }
  function fmt2(n) { return (Number(n) || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function pad(n) { return ('0' + n).slice(-2); }
  function today() { if (S.d && S.d.today) return S.d.today; var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
  function ld(iso) { if (!iso) return ''; var p = String(iso).slice(0, 10).split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
  function lm(m) { if (!m) return ''; var p = m.split('-'); return p[1] + '/' + p[0]; }
  function diff(a, b) { var pa = a.split('-').map(Number), pb = b.split('-').map(Number); return Math.round((Date.UTC(pb[0], pb[1] - 1, pb[2]) - Date.UTC(pa[0], pa[1] - 1, pa[2])) / 864e5); }
  function pill(arr) { return '<span class="rt-pill ' + arr[1] + '">' + esc(arr[0]) + '</span>'; }
  function cleanErr(e) { return String(e && e.message ? e.message : e).replace(/^(Exception|Error):\s*/, ''); }

  /** ເອີ້ນ server: ໃສ່ username ຂອງຜູ້ໃຊ້ອັດຕະໂນມັດ ແລະ ກວດ success */
  function call(fn) {
    var args = [currentUser ? currentUser.username : ''].concat(Array.prototype.slice.call(arguments, 1));
    return new Promise(function (res, rej) {
      var r = google.script.run
        .withSuccessHandler(function (x) { if (x && x.success === false) rej(new Error(x.error)); else res(x); })
        .withFailureHandler(rej);
      r[fn].apply(r, args);
    });
  }
  function loading(t) { Swal.fire({ title: t || 'ກຳລັງດຳເນີນການ…', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } }); }
  function ok(t) { Swal.fire({ icon: 'success', title: t, timer: 1400, showConfirmButton: false }); }
  function fail(e) { Swal.fire({ icon: 'error', title: 'ບໍ່ສຳເລັດ', text: cleanErr(e) }); }

  /* ---------- ຂໍ້ມູນຊ່ວຍ ---------- */
  function sup(id) { return (S.d.suppliers || []).find(function (s) { return s.id === id; }) || { name: '-' }; }
  function ct(id) { return (S.d.contracts || []).find(function (c) { return c.id === id; }) || { plate: '(ລຶບແລ້ວ)', vehicle: '' }; }
  function inv(id) { return (S.d.invoices || []).find(function (i) { return i.id === id; }); }
  function cState(c) {
    var t = today();
    if (c.status === 'closed') return 'closed';
    if (c.startDate && c.startDate > t) return 'upcoming';
    if (c.endDate && c.endDate < t) return 'expired';
    if (c.endDate && diff(t, c.endDate) <= ALERT_DAYS) return 'expiring';
    return 'active';
  }
  function paidOf(invId) { return (S.d.payments || []).filter(function (p) { return p.invoiceId === invId; }).reduce(function (s, p) { return s + Number(p.amountLAK || 0); }, 0); }
  function ctLabel(c) { return c.plate + (c.vehicle ? ' (' + c.vehicle + ')' : '') + ' · ' + sup(c.supplierId).name + ' · ' + (c.site || '-'); }
  function opts(list, first) { return (first ? '<option value="">' + first + '</option>' : '') + list.map(function (x) { return '<option value="' + esc(x[0]) + '">' + esc(x[1]) + '</option>'; }).join(''); }
  function setSel(id, html) { var el = $(id), k = el.value; el.innerHTML = html; el.value = k; if (el.value !== k) el.value = ''; }
  function editBtns(key, id) {
    var pg = key === 'logs' ? 'logs' : key === 'payments' ? 'payments' : 'contracts';
    return '<td class="rt-need-' + pg + '" style="white-space:nowrap"><button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="RT.edit(\'' + key + '\',\'' + esc(id) + '\')"><i class="bi bi-pencil"></i></button> ' +
      '<button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="RT.del(\'' + key + '\',\'' + esc(id) + '\')"><i class="bi bi-trash"></i></button></td>';
  }

  /* ---------- ເປີດໜ້າ (ເອີ້ນຈາກ switchTab) ---------- */
  function lvl(sec) { return (S.d && S.d.perm && S.d.perm[sec]) || 'none'; }
  function applyPerm() {
    var L = lvl(S.sec), denied = L === 'none';
    ['contracts', 'logs', 'billing', 'payments'].forEach(function (k) { $('rental-content').classList.toggle('rt-no-' + k, lvl(k) !== 'edit'); });
    $('rtDenied').style.display = denied ? 'block' : 'none';
    document.querySelectorAll('#rental-content section[data-sec]').forEach(function (s) { s.classList.toggle('on', !denied && s.dataset.sec === S.sec); });
    $('rtSub').textContent = 'ຂໍ້ມູນ ' + ld(today()) + ' · ' + (currentUser ? currentUser.name : '') + ' · ' + (L === 'edit' ? 'ສິດແກ້ໄຂ' : L === 'view' ? 'ສິດເບິ່ງຢ່າງດຽວ' : 'ບໍ່ມີສິດ');
  }
  function open(sec) {
    S.sec = sec || S.sec;
    $('rtTitle').textContent = TITLES[S.sec] || '🚜 ລົດເຊົ່າພາກສະໜາມ';
    if (!S.d) { document.querySelectorAll('#rental-content section[data-sec]').forEach(function (s) { s.classList.remove('on'); }); reload(); return; }
    applyPerm();
    if (S.sec === 'report') renderReport();
  }
  function reload() {
    $('rtSub').textContent = 'ກຳລັງໂຫຼດຂໍ້ມູນ…';
    return call('rtLoadAll').then(function (r) { S.d = r.data; renderAll(); })
      .catch(function (e) { $('rtSub').textContent = 'ໂຫຼດບໍ່ສຳເລັດ'; fail(e); });
  }

  /* ---------- ຟອມ ---------- */
  function formData(f) { var o = {}; f.querySelectorAll('[name]').forEach(function (i) { o[i.name] = i.value.trim(); }); return o; }
  function fillForm(f, o) { f.querySelectorAll('[name]').forEach(function (i) { i.value = o[i.name] == null ? '' : o[i.name]; }); }
  function resetForm(id) {
    var f = $(id); f.reset(); f.querySelector('[name=id]').value = '';
    if (f.querySelector('[name=date]')) f.querySelector('[name=date]').value = today();
    if (id === 'rtCtForm') { $('rtCtTitle').innerHTML = '<i class="bi bi-file-earmark-text"></i> ສັນຍາເຊົ່າລົດ'; ctHints(); }
    if (id === 'rtLgForm') { $('rtLgTitle').innerHTML = '<i class="bi bi-clipboard-check"></i> ບັນທຶກການໃຊ້ລົດເຊົ່າປະຈຳວັນ'; $('rtLgHint').style.display = 'none'; }
    if (id === 'rtPmForm') renderInvoiceSelect();
  }
  function submit(ev, key) {
    ev.preventDefault();
    var f = ev.target, o = formData(f);
    loading('ກຳລັງບັນທຶກ…');
    call('rtSave', key, o).then(function (r) { S.d = r.data; renderAll(); resetForm(f.id); ok(o.id ? 'ແກ້ໄຂແລ້ວ' : 'ບັນທຶກແລ້ວ'); }).catch(fail);
    return false;
  }
  function edit(key, id) {
    var map = { suppliers: ['rtSpForm', 'contracts'], contracts: ['rtCtForm', 'contracts'], logs: ['rtLgForm', 'logs'], payments: ['rtPmForm', 'payments'] };
    var m = map[key], o = (S.d[key] || []).find(function (x) { return x.id === id; });
    if (!o) return;
    if (S.sec !== m[1]) switchTab('rental-' + m[1]);
    if (key === 'payments') renderInvoiceSelect(o.invoiceId);
    fillForm($(m[0]), o);
    if (key === 'contracts') { $('rtCtTitle').innerHTML = '<i class="bi bi-pencil-square"></i> ແກ້ໄຂສັນຍາ ' + esc(o.contractNo || o.plate); ctHints(); }
    if (key === 'logs') { $('rtLgTitle').innerHTML = '<i class="bi bi-pencil-square"></i> ແກ້ໄຂບັນທຶກ ' + ld(o.date); lgContract(); }
    $(m[0]).scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function del(key, id) {
    Swal.fire({ icon: 'warning', title: 'ຢືນຢັນການລຶບ?', text: 'ລຶບແລ້ວຈະກູ້ຄືນບໍ່ໄດ້', showCancelButton: true, confirmButtonText: 'ລຶບ', cancelButtonText: 'ຍົກເລີກ', confirmButtonColor: '#e74c3c' })
      .then(function (r) {
        if (!r.isConfirmed) return;
        loading('ກຳລັງລຶບ…');
        call('rtDelete', key, id).then(function (x) { S.d = x.data; renderAll(); ok('ລຶບແລ້ວ'); }).catch(fail);
      });
  }
  function ctHints() {
    var lak = $('rtCtCur').value === 'LAK'; $('rtCtFx').disabled = lak; if (lak) $('rtCtFx').value = 1;
    var t = $('rtCtType').value;
    $('rtCtMinLbl').textContent = t === 'hour' ? 'ຊົ່ວໂມງຂັ້ນຕ່ຳ / ເດືອນ' : t === 'day' ? 'ມື້ຂັ້ນຕ່ຳ / ເດືອນ' : 'ຂັ້ນຕ່ຳ (ບໍ່ໃຊ້ກັບລາຍເດືອນ)';
    $('rtCtMin').disabled = t === 'month';
    $('rtCtFuelPrice').disabled = $('rtCtFuel').value !== 'supplier';
  }
  function lgContract() {
    var c = ct($('rtLgCt').value), hint = $('rtLgHint');
    if (!c.id) { $('rtLgSite').value = ''; hint.style.display = 'none'; return; }
    $('rtLgSite').value = c.site || '';
    var isEdit = !!$('rtLgForm').querySelector('[name=id]').value;
    var last = (S.d.logs || []).filter(function (l) { return l.contractId === c.id && l.meterEnd !== ''; }).sort(function (a, b) { return a.date < b.date ? 1 : -1; })[0];
    if (last && !isEdit && !$('rtLgMs').value) $('rtLgMs').value = last.meterEnd;
    hint.style.display = 'block';
    hint.innerHTML = '<b>' + RATE[c.rateType] + '</b> ' + fmt2(c.rate) + ' ' + (CUR[c.currency] || 'ກີບ') + '/' + UNIT[c.rateType] +
      (c.fuelBy === 'supplier' ? ' · ຜູ້ໃຫ້ເຊົ່າຈ່າຍນ້ຳມັນ: ນ້ຳມັນທີ່ເຕີມໃນລະບົບຈະຖືກຫັກ ' + fmt(c.fuelPriceLAK) + ' ກີບ/ລິດ' : ' · ບໍລິສັດຈ່າຍນ້ຳມັນເອງ') +
      (last ? '<br>ເລກເລີກຄັ້ງກ່ອນ: <b>' + fmt2(last.meterEnd) + '</b> (' + ld(last.date) + ')' : '');
  }
  function lgHours() { var a = parseFloat($('rtLgMs').value), b = parseFloat($('rtLgMe').value); if (!isNaN(a) && !isNaN(b) && b >= a) $('rtLgH').value = Math.round((b - a) * 100) / 100; }
  function lgPull() {
    var c = ct($('rtLgCt').value), d = $('rtLgDate').value;
    if (!c.id || !d) { fail('ກະລຸນາເລືອກວັນທີ ແລະ ລົດເຊົ່າກ່ອນ'); return; }
    loading('ກຳລັງດຶງຂໍ້ມູນ…');
    call('rtFieldDay', c.plate, d).then(function (r) {
      Swal.close();

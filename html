<!-- ================= 📱💻 RESPONSIVE SCRIPT (ເມນູເລື່ອນ, ຫົວຂໍ້ໜ້າ, ຕາຕະລາງເປັນບັດ) ================= -->
<script>
/* 🖨️ ພິມເອກະສານຂອງ ລົດເຊົ່າ / ສ້ອມແປງ / ຄູ່ມື: ໃສ່ເນື້ອຫາໃນ #rtPrint ແລະ ເປີດໂໝດພິມຊົ່ວຄາວ.
   ເມື່ອພິມແລ້ວ (ຫຼື ເມື່ອລາຍງານອື່ນສັ່ງພິມ) ລ້າງອອກທັນທີ — ເພື່ອບໍ່ໃຫ້ໜ້າອື່ນພິມອອກເປັນເອກະສານເກົ່າ */
var sfPrinting = false;
function sfClearPrint() {
  document.body.classList.remove('sf-printing');
  var p = document.getElementById('rtPrint'); if (p) p.innerHTML = '';
}
function sfPrint(html) {
  var p = document.getElementById('rtPrint');
  if (!p) { p = document.createElement('div'); p.id = 'rtPrint'; document.body.appendChild(p); }
  p.innerHTML = html;
  document.body.classList.add('sf-printing');
  sfPrinting = true;
  setTimeout(function () { window.print(); sfPrinting = false; }, 150);
}
window.addEventListener('beforeprint', function () { if (!sfPrinting) sfClearPrint(); });
window.addEventListener('afterprint', function () { sfPrinting = false; sfClearPrint(); });

var RESP = (function () {
  var MOBILE = window.matchMedia('(max-width: 991.98px)');
  var body = document.body;
  function sidebar() { return document.querySelector('#main-app .sidebar'); }

  /* ---------- ເມນູເລື່ອນ (drawer) ---------- */
  function openDrawer() {
    if (!MOBILE.matches) return;
    body.classList.add('drawer-open');
    var btn = document.getElementById('appbarMenuBtn'); if (btn) btn.setAttribute('aria-expanded', 'true');
    var active = document.querySelector('#mainTabs .nav-link.active');
    if (active) active.scrollIntoView({ block: 'center' });
  }
  function closeDrawer() {
    body.classList.remove('drawer-open');
    var btn = document.getElementById('appbarMenuBtn'); if (btn) btn.setAttribute('aria-expanded', 'false');
  }
  function toggleDrawer() { body.classList.contains('drawer-open') ? closeDrawer() : openDrawer(); }

  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });
  (MOBILE.addEventListener ? MOBILE.addEventListener.bind(MOBILE, 'change') : MOBILE.addListener.bind(MOBILE))(function () { closeDrawer(); refreshAll(); });

  // ປັດຊ້າຍເພື່ອປິດເມນູ · ປັດຂວາຈາກຂອບຈໍເພື່ອເປີດເມນູ
  var tx = null, ty = null;
  document.addEventListener('touchstart', function (e) {
    var t = e.touches[0]; tx = t.clientX; ty = t.clientY;
    if (!body.classList.contains('drawer-open') && tx > 20) tx = null;
  }, { passive: true });
  document.addEventListener('touchend', function (e) {
    if (tx === null || !MOBILE.matches) return;
    var t = e.changedTouches[0], dx = t.clientX - tx, dy = t.clientY - ty;
    if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      if (dx < 0 && body.classList.contains('drawer-open')) closeDrawer();
      if (dx > 0 && !body.classList.contains('drawer-open') && document.getElementById('main-app').style.display !== 'none') openDrawer();
    }
    tx = null;
  }, { passive: true });

  /* ---------- ຫົວຂໍ້ໜ້າໃນແຖບເທິງ ---------- */
  function setTitle(tabName) {
    var btn = tabName ? document.getElementById(tabName + '-tab') : document.querySelector('#mainTabs .nav-link.active');
